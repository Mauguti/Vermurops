rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Denegar todo lo que no esté explícitamente permitido ──────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Cotizaciones ──────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer y crear/actualizar.
    // Eliminar está prohibido: una cotización perdida se marca como 'perdida',
    // nunca se borra del historial.
    match /cotizaciones/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Prospectos / leads ────────────────────────────────────────────────
    // Antes vivían solo en memoria: se perdían al recargar. Mismo patrón que
    // cotizaciones — un lead perdido se marca, no se borra del historial.
    match /prospectos/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Contadores (usado por folioService.generateFolio) ─────────────────
    // generateFolio() hace runTransaction: necesita leer Y escribir.
    // Solo usuarios autenticados pueden tocar el contador.
    match /contadores/{id} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;
    }

    // ── Clientes ──────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer y crear/actualizar.
    // Eliminar está prohibido: un cliente inactivo se marca statusOperativo='INACTIVO'.
    match /clientes/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Proveedores ─────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer y crear/actualizar.
    // Eliminar está prohibido: un proveedor inactivo se marca activo=false.
    match /proveedores/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Conceptos ────────────────────────────────────────────────────────
    // Catálogo de conceptos/servicios (105 registros de Magaya).
    // Baja lógica: un concepto inactivo se marca activo=false.
    match /conceptos/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Términos de pago ────────────────────────────────────────────────
    // Catálogo de términos/condiciones de pago (25 registros).
    // Baja lógica: un término inactivo se marca activo=false.
    match /terminosPago/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Puertos (E10.0) ─────────────────────────────────────────────────
    // Catálogo de puertos marítimos. Mismo patrón que proveedores.
    // Baja lógica: un puerto inactivo se marca activo=false.
    match /puertos/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Tarifas (TA-1) ──────────────────────────────────────────────────
    // Catálogo de tarifas (precios por concepto + proveedor + ruta).
    // Baja lógica: una tarifa inactiva se marca activo=false.
    // Queries del listener acotado usan: activo + fechaFin.
    match /tarifas/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Embarques (E-1) ──────────────────────────────────────────────────
    // Antes vivían en memoria y se perdían al recargar.
    // Eliminar está prohibido: un embarque cancelado se marca en sus cierres,
    // nunca se borra — es el respaldo de lo que se cobró y se pagó.
    match /embarques/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Órdenes de Compra (OC-1) ─────────────────────────────────────────
    // Cualquier usuario autenticado puede leer y crear/actualizar.
    // Eliminar está prohibido: una OC cancelada se marca activo=false.
    match /ordenesCompra/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Vistas de usuario (TV-4) ─────────────────────────────────────────
    // Lectura: autenticado (para ver vistas compartidas de otros).
    // Creación: autenticado, siempre que usuarioId == su UID.
    // Actualización/Borrado: solo el creador (usuarioId == UID).
    match /vistasUsuario/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid;
    }

    // ── Notificaciones ────────────────────────────────────────────────────
    // Lectura: solo el destinatario nombrado en el documento.
    //   Alinea con la query de NotificationsContext:
    //   where('destinatarioId', '==', user.uid)
    // Creación: cualquier usuario autenticado puede crear (p.ej. mensaje de chat
    //   que genera notificación para otro usuario).
    // Actualización: solo el propio destinatario puede marcarla leída.
    match /notificaciones/{id} {
      allow read:   if request.auth != null
                    && resource.data.destinatarioId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.destinatarioId == request.auth.uid;
      allow delete: if false;
    }

  }
}
