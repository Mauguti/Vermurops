rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firebase Storage — VermurOps
//
// Se guardan tres familias de documentos:
//   tarifarios/   evidencias de costos (el documento del que salió una tarifa)
//   expedientes/  documentos KYC del alta de clientes (§D, 4-sep-2026)
//   embarques/    documentos operativos del embarque (BL, pedimento, facturas)
//   cotizaciones/ el PDF de cada versión de la cotización
//
// ⚠️ Estas reglas todavía NO distinguen roles: el rol se deriva en el cliente y
// no viaja en el token (§6). Desde el Bloque 9 sí distinguen QUIÉN: solo el
// equipo, por correo. Aquí vive el expediente KYC —actas, RFC, comprobantes—,
// así que el parche importa más que en ningún otro lado.
// ─────────────────────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    /*
     * ── Quién es del equipo (Bloque 9, 25-sep-2026) ──────────────────────
     * Parche mientras el rol no viaja en el token. Hasta hoy bastaba con
     * estar autenticado, y el registro público estuvo ABIERTO: cualquiera
     * que leyera la API key del bundle podía crearse una cuenta y leer y
     * escribir toda la base. El registro ya se cerró; esto asegura que, si
     * volviera a abrirse o alguien creara una cuenta por otra vía, no
     * alcance ni un documento.
     *
     * Es una LISTA DE CORREOS a propósito: el rol no está en el token
     * todavía. Cuando Usuarios y roles ponga los claims, esta función se
     * sustituye por permisos por rol (paso 3) y la lista desaparece.
     *
     * ⚠️ Una cuenta recién invitada que no esté aquí NO puede entrar: la
     * pantalla de Usuarios avisa, y el correo se agrega en el mismo cambio.
     *
     * Las cuentas de prueba del emulador NO van aquí: se inyectan al
     * generar las reglas del emulador (scripts/reglasEmulador.sh), para no
     * dejar en producción correos que alguien pueda crear después.
     */
    function esDelEquipo() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          // EQUIPO:INICIO — generado también para el emulador; no reordenar a mano
          'itzel.laurean@vermur.com',
          'nohema.sosa@vermur.com',
          'julio.gutierrez@vermur.com',
          'angel.luna@vermur.com',
          'gabriela.huerta@vermur.com',
          'luis.renteria@vermur.com',
          'info@digsol.com'
          // EQUIPO:FIN
        ];
    }


    // Denegar todo lo no declarado.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Tarifarios y evidencias, agrupados por año/mes.
    match /tarifarios/{anio}/{mes}/{archivo} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo()
                    && request.resource.size < 10 * 1024 * 1024;
      // No se sobrescriben ni se borran: la evidencia de un costo no se edita.
      allow update, delete: if false;
    }

    // Expediente KYC del cliente. Mismo patrón que tarifarios: un documento
    // legal (acta, CSF, comprobante) es evidencia y no se edita ni se pisa.
    match /expedientes/{clienteId}/{archivo} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo()
                    && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // El PDF de cada versión de la cotización: evidencia de lo que se le
    // mandó al cliente. Inmutable, como toda evidencia.
    match /cotizaciones/{cotizacionId}/pdf/{archivo} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo()
                    && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Documentos del embarque. Un BL o un pedimento con otra versión se sube
    // como archivo nuevo; el original queda para la trazabilidad.
    match /embarques/{embarqueId}/docs/{archivo} {
      allow read: if esDelEquipo();
      allow create: if esDelEquipo()
                    && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
