{
  "name": "VermurOps · enviar-correo (Gmail)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enviar-correo",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c1d2-0001-4c3e-9a10-000000000001",
      "name": "Recibe correo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "vermurops-enviar-correo",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ikvB6W9j9yOAniV9",
          "name": "X-Vermur-Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Valida y arma el correo. Body esperado:\n// { para: string | string[], asunto: string, html: string, texto?: string,\n//   responderA?: string, nombreRemitente?: string }\n// Por seguridad, mientras el remitente sea la cuenta de Gmail de Mau,\n// solo se permiten destinatarios de estos dominios.\nconst DOMINIOS_PERMITIDOS = ['vermur.com', 'digsol.com.mx'];\n\nconst b = $input.first().json.body ?? {};\nconst lista = (Array.isArray(b.para) ? b.para : String(b.para ?? '').split(','))\n  .map(s => String(s).trim().toLowerCase())\n  .filter(Boolean);\n\nconst errores = [];\nif (lista.length === 0) errores.push('falta «para»');\nif (lista.length > 20) errores.push('máximo 20 destinatarios por correo');\nconst correoValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nfor (const c of lista) {\n  if (!correoValido.test(c)) errores.push(`correo inválido: ${c}`);\n  else if (!DOMINIOS_PERMITIDOS.includes(c.split('@')[1])) errores.push(`dominio no permitido: ${c}`);\n}\nif (!b.asunto || !String(b.asunto).trim()) errores.push('falta «asunto»');\nif (!b.html || !String(b.html).trim()) errores.push('falta «html»');\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    error: errores.join('; '),\n    para: lista.join(','),\n    asunto: String(b.asunto ?? '').slice(0, 200),\n    html: String(b.html ?? ''),\n    responderA: String(b.responderA ?? ''),\n    nombreRemitente: String(b.nombreRemitente ?? 'VermurOps')\n  }\n}];"
      },
      "id": "a1f0c1d2-0002-4c3e-9a10-000000000002",
      "name": "Valida y arma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0ffee00-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c1d2-0003-4c3e-9a10-000000000003",
      "name": "¿Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.para }}",
        "subject": "={{ $json.asunto }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $json.nombreRemitente }}",
          "replyTo": "={{ $json.responderA || undefined }}"
        }
      },
      "id": "a1f0c1d2-0004-4c3e-9a10-000000000004",
      "name": "Envía por Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, 200],
      "webhookId": "vermurops-enviar-correo-gmail",
      "onError": "continueErrorOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "ELEGIR_AL_IMPORTAR",
          "name": "Gmail de Mau"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, id: $json.id ?? null, para: $('Valida y arma').first().json.para }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1f0c1d2-0005-4c3e-9a10-000000000005",
      "name": "Enviado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Gmail no aceptó el envío', detalle: $json.error?.message ?? $json.error ?? null }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "a1f0c1d2-0006-4c3e-9a10-000000000006",
      "name": "Falló Gmail",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.error }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1f0c1d2-0007-4c3e-9a10-000000000007",
      "name": "Rechazado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 420]
    }
  ],
  "connections": {
