      target_content: "import React, { useState } from \'react\';\nimport { initialClients, Client } from \'../data\';\nimport { Search, Building2, Phone, Mail, Package, FileText, ChevronRight } from \'lucide-react\';\n\nexport default function Clients() {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedClient, setSelectedClient] = useState<Client | null>(null);\n\n  const filteredClients = initialClients.filter(c => \n    c.name.toLowerCase().includes(searchTerm.toLowerCase()) || \n    c.rfc.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-[24px]\">\n      {!selectedClient ? (\n        <>\n          <div className=\"flex justify-between items-center hidden\">\n            <h2 className=\"text-[20px] font-semibold text-text-primary\">Directorio de Clientes</h2>\n          </div>\n\n          <div className=\"flex justify-between items-center mb-[24px] space-x-[16px]\">\n            <div className=\"relative flex-1 max-w-[400px]\">\n              <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por raz\303\263n social, RFC...\" \n                value={searchTerm}\n                onChange={(e) => setSearchTerm(e.target.value)}\n                className=\"w-full pl-[36px] pr-[12px] py-[10px] outline-none text-[14px] bg-card border border-card-border rounded-[8px] focus:border-brand focus:ring-1 focus:ring-brand shadow-sm text-text-primary\"\n              />\n            </div>\n            <button className=\"bg-brand text-white px-[16px] py-[10px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover shadow-sm transition-colors shrink-0\">\n              Nuevo Cliente\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]\">\n            {filteredClients.map(client => (\n              <div \n                key={client.id}\n                className=\"bg-card rounded-[12px] border border-card-border hover:border-brand/30 transition-all overflow-hidden group flex flex-col cursor-pointer shadow-sm\"\n              >\n                <div className=\"p-[24px] flex justify-between items-start\">\n                  <div>\n                    <h3 className=\"font-semibold text-text-primary text-[15px] leading-tight mb-1 group-hover:text-brand transition-colors\">{client.name}</h3>\n                    <p className=\"text-[12px] text-text-muted font-mono\">RFC: {client.rfc}</p>\n                  </div>\n                </div>\n                \n                <div className=\"px-[24px] pb-[20px] space-y-[12px] flex-1\">\n                  <div className=\"flex items-center text-[13px] text-text-secondary\">\n                    <Mail className=\"w-4 h-4 mr-3 text-text-muted\" />\n                    <span className=\"truncate\">{client.email}</span>\n                  </div>\n                  <div className=\"flex items-center text-[13px] text-text-secondary\">\n                    <Phone className=\"w-4 h-4 mr-3 text-text-muted\" />\n                    {client.phone}\n                  </div>\n                </div>\n                \n                <div className=\"grid grid-cols-2 divide-x divide-divider border-t border-divider bg-canvas\">\n                  <div className=\"p-[16px] text-center\">\n                    <div className=\"text-[11px] text-text-muted uppercase tracking-[0.05em] font-medium mb-[4px]\">Embarques</div>\n                    <div className=\"font-medium text-text-primary text-[15px] tabular-nums\">{client.shipmentsCount}</div>\n                  </div>\n                  <div className=\"p-[16px] text-center\">\n                    <div className=\"text-[11px] text-text-muted uppercase tracking-[0.05em] font-medium mb-[4px]\">Cotizaciones</div>\n                    <div className=\"font-medium text-text-primary text-[15px] tabular-nums\">{client.quotesCount}</div>\n                  </div>\n                </div>\n\n                <div \n                  onClick={() => setSelectedClient(client)}\n                  className=\"bg-surface-elevated text-text-inverse text-center py-[12px] text-[13px] font-medium hover:bg-surface-dark transition-colors\"\n                >\n                  Ver Perfil\n                </div>\n              </div>\n            ))}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-[24px]\">\n          <div className=\"flex items-center justify-between mb-[24px]\">\n            <div className=\"flex items-center space-x-2 text-[13px] text-text-secondary\">\n              <button onClick={() => setSelectedClient(null)} className=\"hover:text-text-primary transition-colors\">Clientes</button>\n              <ChevronRight className=\"w-4 h-4 text-text-muted\" />\n              <span className=\"text-text-primary font-medium\">{selectedClient.name}</span>\n            </div>\n            <button className=\"bg-brand hover:bg-brand-hover text-white px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium transition-colors shadow-sm\">\n              Nueva cotizaci\303\263n\n            </button>\n          </div>\n\n          <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm p-[32px]\">\n            <div className=\"flex flex-col md:flex-row gap-[32px] items-start\">\n              \n              <div className=\"w-full md:w-1/3 bg-canvas p-[24px] rounded-[12px] border border-card-border\">\n                <div className=\"w-16 h-16 bg-surface-dark text-text-inverse flex items-center justify-center rounded-full text-2xl font-semibold mb-[20px]\">\n                  {selectedClient.name.charAt(0)}\n                </div>\n                <h3 className=\"text-[18px] font-semibold text-text-primary mb-1\">{selectedClient.name}</h3>\n                <p className=\"text-text-muted font-mono text-[12px] mb-[24px]\">RFC: {selectedClient.rfc}</p>\n                \n                <h4 className=\"font-semibold text-[11px] tracking-[0.05em] text-text-muted uppercase mb-[8px]\">Contacto Principal</h4>\n                <p className=\"font-medium text-text-primary text-[14px] mb-[4px]\">{selectedClient.contact}</p>\n                <div className=\"flex items-center text-[13px] text-text-secondary mb-[8px]\">\n                  <Mail className=\"w-4 h-4 mr-2 text-text-muted\" />\n                  <span className=\"truncate\">{selectedClient.email}</span>\n                </div>\n                <div className=\"flex items-center text-[13px] text-text-secondary\">\n                  <Phone className=\"w-4 h-4 mr-2 text-text-muted\" />\n                  {selectedClient.phone}\n                </div>\n              </div>\n\n              <div className=\"w-full md:w-2/3 space-y-[24px]\">\n                <div>\n                  <h4 className=\"font-semibold text-[15px] text-text-primary border-b border-divider pb-[8px] mb-[16px]\">Historial de Operaciones</h4>\n                  <div className=\"grid grid-cols-2 gap-[24px]\">\n                    <div className=\"bg-card border border-card-border shadow-sm p-[24px] rounded-[12px] flex items-center\">\n                       <div className=\"bg-neutral-bg p-[12px] rounded-full mr-[16px]\">\n                         <Package className=\"w-6 h-6 text-text-muted\" />\n                       </div>\n                       <div>\n                         <p className=\"text-text-muted text-[11px] uppercase tracking-[0.05em] font-medium\">Embarques Totales</p>\n                         <h3 className=\"text-[28px] font-medium text-text-primary tabular-nums leading-none mt-1\">{selectedClient.shipmentsCount}</h3>\n                       </div>\n                    </div>\n                    <div className=\"bg-card border border-card-border shadow-sm p-[24px] rounded-[12px] flex items-center\">\n                       <div className=\"bg-neutral-bg p-[12px] rounded-full mr-[16px]\">\n                         <FileText className=\"w-6 h-6 text-text-muted\" />\n                       </div>\n                       <div>\n                         <p className=\"text-text-muted text-[11px] uppercase tracking-[0.05em] font-medium\">Cotizaciones</p>\n                         <h3 className=\"text-[28px] font-medium text-text-primary tabular-nums leading-none mt-1\">{selectedClient.quotesCount}</h3>\n                       </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"bg-canvas border border-divider rounded-[12px] p-[32px] flex flex-col items-center justify-center text-center text-text-secondary\">\n                  <Building2 className=\"w-10 h-10 mb-[16px] text-text-muted\" />\n                  <p className=\"font-medium text-text-primary text-[14px]\">Integraci\303\263n CRM</p>\n                  <p className=\"text-[13px] mt-[4px] max-w-sm\">Los documentos y m\303\251tricas espec\303\255ficas se sincronizan desde el m\303\263dulo central de operaciones de Vermur.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { initialClients, Client } from \'../data\';\nimport { Search, Phone, Mail, ChevronRight, Upload, Calendar, ArrowRight, MessageSquare, CheckCircle2, Clock } from \'lucide-react\';\n\nexport default function Clients() {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedClient, setSelectedClient] = useState<Client | null>(null);\n  const [activeTab, setActiveTab] = useState(\'Cuentas\');\n  const [detailTab, setDetailTab] = useState(\'Resumen\');\n\n  const filteredClients = initialClients.filter(c => \n    c.name.toLowerCase().includes(searchTerm.toLowerCase()) || \n    c.rfc.toLowerCase().includes(searchTerm.toLowerCase()) ||\n    c.contact.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const tabs = [\'Cuentas\', \'Contactos\', \'Leads\', \'Oportunidades\'];\n  const detailTabs = [\'Resumen\', \'Embarques\', \'Cotizaciones\', \'Documentos\', \'Estado de cuenta\'];\n\n  return (\n    <div className=\"space-y-[24px]\">\n      {!selectedClient ? (\n        <>\n          {/* Top Tabs */}\n          <div className=\"border-b border-divider mb-[24px]\">\n            <nav className=\"-mb-px flex space-x-[32px]\">\n              {tabs.map((tab) => (\n                <button\n                  key={tab}\n                  onClick={() => setActiveTab(tab)}\n                  className={`pb-[12px] px-[4px] text-[14px] font-medium transition-colors border-b-[2px] ${\n                    activeTab === tab\n                      ? \'border-brand text-text-primary\'\n                      : \'border-transparent text-text-muted hover:text-text-secondary hover:border-text-muted\'\n                  }`}\n                >\n                  {tab}\n                </button>\n              ))}\n            </nav>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row justify-between sm:items-center gap-[16px] mb-[24px]\">\n            <div className=\"relative flex-1 max-w-[480px]\">\n              <Search className=\"w-[18px] h-[18px] absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por raz\303\263n social, RFC, contacto...\" \n                value={searchTerm}\n                onChange={(e) => setSearchTerm(e.target.value)}\n                className=\"w-full pl-[36px] pr-[12px] py-[10px] outline-none text-[14px] bg-card border border-card-border rounded-[8px] focus:border-brand focus:ring-1 focus:ring-brand shadow-sm text-text-primary\"\n              />\n            </div>\n            <div className=\"flex items-center space-x-[12px]\">\n              <button className=\"flex items-center bg-white border border-card-border text-text-primary px-[16px] py-[10px] rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg shadow-sm transition-colors shrink-0\">\n                <Upload className=\"w-[16px] h-[16px] mr-2 text-text-muted\" />\n                Importar CSV\n              </button>\n              <button className=\"bg-brand text-white px-[16px] py-[10px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover shadow-sm transition-colors shrink-0\">\n                Nuevo cliente\n              </button>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-[24px]\">\n            {filteredClients.map(client => (\n              <div \n                key={client.id}\n                className=\"bg-card rounded-[12px] border border-card-border transition-all overflow-hidden flex flex-col shadow-sm\"\n              >\n                <div className=\"p-[20px] pb-[16px]\">\n                  <div className=\"flex justify-between items-start mb-[4px]\">\n                    <h3 className=\"font-semibold text-text-primary text-[15px] leading-snug pr-[12px]\">{client.name}</h3>\n                    <span className={`shrink-0 text-[11px] font-medium tracking-[0.02em] px-[8px] py-[2px] rounded-[4px] ${client.type === \'Cliente\' ? \'bg-info-bg text-info-text\' : \'bg-neutral-bg text-text-secondary\'}`}>\n                      {client.type}\n                    </span>\n                  </div>\n                  <p className=\"text-[13px] text-text-muted font-mono\">{client.rfc}</p>\n                </div>\n                \n                <div className=\"px-[20px] pb-[20px] space-y-[10px] flex-1\">\n                  <div className=\"flex items-center text-[13px] text-text-secondary\">\n                    <Mail className=\"w-[16px] h-[16px] mr-[10px] text-text-muted\" />\n                    <span className=\"truncate\">{client.email}</span>\n                  </div>\n                  <div className=\"flex items-center text-[13px] text-text-secondary\">\n                    <Phone className=\"w-[16px] h-[16px] mr-[10px] text-text-muted\" />\n                    {client.phone}\n                  </div>\n                </div>\n                \n                <div className=\"grid grid-cols-3 divide-x divide-divider border-t border-divider bg-canvas\">\n                  <div className=\"p-[12px] text-center\">\n                    <div className=\"text-[11px] text-text-muted font-medium mb-[2px]\">Embarques</div>\n                    <div className=\"font-medium text-text-primary text-[14px] tabular-nums\">{client.shipmentsCount}</div>\n                  </div>\n                  <div className=\"p-[12px] text-center\">\n                    <div className=\"text-[11px] text-text-muted font-medium mb-[2px]\">Cotizaciones</div>\n                    <div className=\"font-medium text-text-primary text-[14px] tabular-nums\">{client.quotesCount}</div>\n                  </div>\n                  <div className=\"p-[12px] text-center flex flex-col items-center justify-center\">\n                    <div className=\"text-[11px] text-text-muted font-medium mb-[2px]\">Saldo</div>\n                    {client.balanceStatus === \'vencido\' ? (\n                      <span className=\"text-[12px] font-medium text-danger-text bg-danger-bg px-[6px] py-[2px] rounded-[4px] tabular-nums\">\n                        ${client.balance.toLocaleString()}\n                      </span>\n                    ) : (\n                      <span className=\"font-medium text-text-primary text-[14px] tabular-nums\">\n                        ${client.balance.toLocaleString()}\n                      </span>\n                    )}\n                  </div>\n                </div>\n\n                <div \n                  onClick={() => setSelectedClient(client)}\n                  className=\"border-t border-divider py-[12px] text-center cursor-pointer transition-colors hover:bg-neutral-bg group\"\n                >\n                  <span className=\"text-[13px] font-medium text-text-primary group-hover:text-brand transition-colors\">Ver ficha</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-[24px]\">\n          {/* Breadcrumb / Header Ficha */}\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-[8px] text-[13px] text-text-secondary\">\n              <button onClick={() => setSelectedClient(null)} className=\"hover:text-text-primary transition-colors\">Cuentas</button>\n              <ChevronRight className=\"w-4 h-4 text-text-muted\" />\n              <span className=\"text-text-primary font-medium\">{selectedClient.name}</span>\n            </div>\n            <div className=\"flex space-x-[12px]\">\n               <button className=\"bg-white border border-card-border text-text-primary px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg transition-colors shadow-sm\">\n                 Editar\n               </button>\n               <button className=\"bg-brand text-white px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover shadow-sm transition-colors\">\n                 Nueva Operaci\303\263n\n               </button>\n            </div>\n          </div>\n\n          <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm overflow-hidden flex flex-col md:flex-row\">\n            {/* Main Content (Left 2/3) */}\n            <div className=\"flex-1 border-r border-divider flex flex-col\">\n              <div className=\"p-[32px] border-b border-divider bg-white\">\n                <div className=\"flex items-center space-x-[16px] mb-[16px]\">\n                  <div className=\"w-[64px] h-[64px] bg-canvas border border-card-border rounded-[12px] flex items-center justify-center text-[24px] font-medium text-text-primary\">\n                    {selectedClient.name.charAt(0)}\n                  </div>\n                  <div>\n                    <h2 className=\"text-[24px] font-semibold text-text-primary tracking-tight leading-none mb-[8px]\">{selectedClient.name}</h2>\n                    <div className=\"flex items-center text-[13px] space-x-[12px]\">\n                      <span className=\"text-text-secondary font-mono\">RFC: {selectedClient.rfc}</span>\n                      <span className=\"text-divider\">\342\200\242</span>\n                      <span className={`px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium ${selectedClient.type === \'Cliente\' ? \'bg-info-bg text-info-text\' : \'bg-neutral-bg text-text-secondary\'}`}>\n                        {selectedClient.type}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex flex-wrap gap-[24px] mt-[24px] pt-[24px] border-t border-divider\">\n                  <div>\n                    <p className=\"text-[11px] font-medium text-text-muted mb-[4px]\">Contacto Principal</p>\n                    <p className=\"text-[14px] font-medium text-text-primary\">{selectedClient.contact}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-[11px] font-medium text-text-muted mb-[4px]\">Correo</p>\n                    <p className=\"text-[14px] font-medium text-text-primary\">{selectedClient.email}</p>\n                  </div>\n                  <div>\n                     <p className=\"text-[11px] font-medium text-text-muted mb-[4px]\">Tel\303\251fono</p>\n                     <p className=\"text-[14px] font-medium text-text-primary\">{selectedClient.phone}</p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Internal Tabs */}\n              <div className=\"px-[32px] border-b border-divider bg-canvas\">\n                <nav className=\"-mb-px flex space-x-[24px]\">\n                  {detailTabs.map((tab) => (\n                    <button\n                      key={tab}\n                      onClick={() => setDetailTab(tab)}\n                      className={`py-[16px] px-[4px] text-[13px] font-medium transition-colors border-b-[2px] ${\n                        detailTab === tab\n                          ? \'border-brand text-text-primary\'\n                          : \'border-transparent text-text-muted hover:text-text-secondary hover:border-text-muted\'\n                      }`}\n                    >\n                      {tab}\n                    </button>\n                  ))}\n                </nav>\n              </div>\n\n              <div className=\"p-[32px] flex-1 bg-white\">\n                <div className=\"flex items-center justify-center p-[40px] text-text-muted text-[14px] border border-dashed border-card-border rounded-[8px] bg-canvas\">\n                   Contenido de {detailTab}\n                </div>\n              </div>\n            </div>\n\n            {/* Sidebar (Right 1/3) */}\n            <div className=\"w-full md:w-[320px] bg-canvas shrink-0 p-[24px]\">\n              <h3 className=\"text-[14px] font-semibold text-text-primary mb-[20px]\">Actividad Reciente</h3>\n              \n              <div className=\"space-y-[24px]\">\n                {/* Timeline Item */}\n                <div className=\"flex gap-[16px]\">\n                  <div className=\"flex flex-col items-center\">\n                    <div className=\"w-[32px] h-[32px] bg-white border border-card-border rounded-full flex items-center justify-center text-text-primary shadow-sm z-10\">\n                      <MessageSquare className=\"w-[14px] h-[14px]\" />\n                    </div>\n                    <div className=\"w-px h-full bg-divider mt-[8px]\"></div>\n                  </div>\n                  <div className=\"pb-[8px]\">\n                    <p className=\"text-[13px] text-text-primary font-medium mb-[2px]\">Correo enviado</p>\n                    <p className=\"text-[13px] text-text-secondary mb-[4px]\">Cotizaci\303\263n #QT-1004 enviada a {selectedClient.contact}.</p>\n                    <p className=\"text-[12px] text-text-muted flex items-center\">\n                      <Clock className=\"w-[12px] h-[12px] mr-[4px]\" />\n                      Hace 2 horas\n                    </p>\n                  </div>\n                </div>\n\n                {/* Timeline Item */}\n                <div className=\"flex gap-[16px]\">\n                  <div className=\"flex flex-col items-center\">\n                    <div className=\"w-[32px] h-[32px] bg-white border border-card-border rounded-full flex items-center justify-center text-text-primary shadow-sm z-10\">\n                      <CheckCircle2 className=\"w-[14px] h-[14px] text-success-text\" />\n                    </div>\n                    <div className=\"w-px h-full bg-divider mt-[8px]\"></div>\n                  </div>\n                  <div className=\"pb-[8px]\">\n                    <p className=\"text-[13px] text-text-primary font-medium mb-[2px]\">Embarque entregado</p>\n                    <p className=\"text-[13px] text-text-secondary mb-[4px]\">El embarque SHP-2023-004 fue entregado en Manzanillo.</p>\n                    <p className=\"text-[12px] text-text-muted flex items-center\">\n                      <Calendar className=\"w-[12px] h-[12px] mr-[4px]\" />\n                      20 Oct, 2023\n                    </p>\n                  </div>\n                </div>\n\n                {/* Timeline Item */}\n                <div className=\"flex gap-[16px]\">\n                  <div className=\"flex flex-col items-center\">\n                    <div className=\"w-[32px] h-[32px] bg-white border border-card-border rounded-full flex items-center justify-center text-text-primary shadow-sm z-10\">\n                      <ArrowRight className=\"w-[14px] h-[14px]\" />\n                    </div>\n                  </div>\n                  <div className=\"pb-[8px]\">\n                    <p className=\"text-[13px] text-text-primary font-medium mb-[2px]\">Oportunidad ganada</p>\n                    <p className=\"text-[13px] text-text-secondary mb-[4px]\">Negocio cerrado v\303\255a mar\303\255tima.</p>\n                    <p className=\"text-[12px] text-text-muted flex items-center\">\n                      <Calendar className=\"w-[12px] h-[12px] mr-[4px]\" />\n                      15 Oct, 2023\n                    </p>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
    }
