    instruction: "Update Quotes colors, forms and tables to new clean minimalism style"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { initialQuotes, initialClients, TransportType, Incoterm } from \'../data\';\nimport { Plane, Ship, Truck, FileText, Check, X, Clock } from \'lucide-react\';\n\nexport default function Quotes() {\n  const [showForm, setShowForm] = useState(false);\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Enviada\': return <span className=\"flex items-center px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs font-medium\"><Clock className=\"w-3 h-3 mr-1\"/> Enviada</span>;\n      case \'Aceptada\': return <span className=\"flex items-center px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-medium\"><Check className=\"w-3 h-3 mr-1\"/> Aceptada</span>;\n      case \'Rechazada\': return <span className=\"flex items-center px-2 py-1 bg-gray-200 text-gray-800 rounded text-xs font-medium\"><X className=\"w-3 h-3 mr-1\"/> Rechazada</span>;\n      case \'Vencida\': return <span className=\"flex items-center px-2 py-1 bg-red-100 text-red-800 rounded text-xs font-medium\"><Clock className=\"w-3 h-3 mr-1\"/> Vencida</span>;\n      default: return null;\n    }\n  };\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-4 h-4 mr-2\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-4 h-4 mr-2\" />;\n      case \'Terrestre\': return <Truck className=\"w-4 h-4 mr-2\" />;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center mb-6\">\n        <h2 className=\"text-[18px] font-semibold text-navy hidden\">M\303\263dulo de Cotizaciones</h2>\n        <div className=\"flex-1\"></div>\n        <button \n          onClick={() => setShowForm(!showForm)}\n          className=\"bg-coral text-white px-[16px] py-[8px] rounded text-[13px] font-semibold hover:opacity-90 transition-opacity uppercase\"\n        >\n          {showForm ? \'Volver al listado\' : \'Nueva Cotizaci\303\263n\'}\n        </button>\n      </div>\n\n      {showForm ? (\n        <div className=\"flex flex-col md:flex-row gap-[30px]\">\n          <div className=\"flex-[1.5]\">\n            <h3 className=\"text-[18px] font-semibold mb-[20px] text-navy\">Nueva Cotizaci\303\263n</h3>\n            <form className=\"space-y-5\" onSubmit={(e) => { e.preventDefault(); alert(\'Cotizaci\303\263n generada correctamente.\'); setShowForm(false); }}>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[15px]\">\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Cliente</label>\n                  <select className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\">\n                    <option value=\"\">Selecciona un cliente</option>\n                    {initialClients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Tipo</label>\n                  <select className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\">\n                     {[\'A\303\251reo\', \'Mar\303\255timo\', \'Terrestre\'].map((type) => (\n                       <option key={type} value={type}>{type}</option>\n                     ))}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Origen</label>\n                  <input type=\"text\" className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\" defaultValue=\"Shanghai (CNSHA)\" />\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Destino</label>\n                  <input type=\"text\" className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\" defaultValue=\"Manzanillo (MXZLO)\" />\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Peso (KG)</label>\n                  <input type=\"number\" className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\" defaultValue=\"12500\" />\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Volumen (M3)</label>\n                  <input type=\"number\" className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\" defaultValue=\"24\" />\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Incoterm</label>\n                  <select className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\">\n                    <option>CIF</option>\n                    <option>FOB</option>\n                    <option>EXW</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-navy text-[12px] font-bold mb-[6px] uppercase\">Notas</label>\n                  <input type=\"text\" className=\"w-full border border-gray-200 rounded p-[12px] focus:border-coral focus:outline-none\" placeholder=\"Carga general\" />\n                </div>\n              </div>\n              \n              <div className=\"flex space-x-3 pt-4\">\n                <button type=\"submit\" className=\"hidden\"></button>\n                <button \n                  type=\"button\" \n                  onClick={() => setShowForm(false)}\n                  className=\"px-[16px] py-[8px] border border-navy text-navy rounded text-[13px] font-semibold hover:bg-gray-50 transition-colors\"\n                >\n                  Cancelar\n                </button>\n              </div>\n            </form>\n          </div>\n          \n          <div className=\"flex-1 bg-white p-[20px] rounded border border-gray-100 self-start\">\n            <h4 className=\"font-semibold text-navy text-[15px]\">Tarifas Disponibles</h4>\n            <div className=\"my-[20px] flex flex-col space-y-0\">\n               <div className=\"p-[10px] border-b border-gray-100 flex justify-between text-[14px]\">\n                 <span>Hapag-Lloyd</span>\n                 <strong>$2,450 USD</strong>\n               </div>\n               <div className=\"p-[10px] border-b border-gray-100 flex justify-between text-[14px]\">\n                 <span>MSC</span>\n                 <strong>$2,380 USD</strong>\n               </div>\n               <div className=\"p-[10px] border-b border-gray-100 flex justify-between text-[14px]\">\n                 <span>CMA CGM</span>\n                 <strong>$2,510 USD</strong>\n               </div>\n            </div>\n            <button className=\"w-full bg-coral text-white font-semibold text-[13px] py-[10px] rounded transition-opacity hover:opacity-90 uppercase\">\n              Generar cotizaci\303\263n PDF\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"bg-white rounded shadow-sm overflow-hidden\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full border-collapse\">\n              <thead>\n                <tr>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Cotizaci\303\263n</th>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Cliente</th>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Detalles</th>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Fecha</th>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Valor</th>\n                  <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Estatus</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-100\">\n                {initialQuotes.map(quote => {\n                  const client = initialClients.find(c => c.id === quote.clientId)?.name;\n                  return (\n                    <tr key={quote.id}>\n                      <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100 font-bold\">{quote.id}</td>\n                      <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{client}</td>\n                      <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">\n                        <div className=\"flex items-center\">\n                          {getTransportIcon(quote.type)}\n                          <span>{quote.origin} \342\206\222 {quote.destination}</span>\n                        </div>\n                      </td>\n                      <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{quote.date}</td>\n                      <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">${quote.total.toLocaleString()}</td>\n                      <td className=\"px-[20px] py-[14px] border-b border-gray-100\">\n                        {getStatusBadge(quote.status)}\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { initialQuotes, initialClients, TransportType, Incoterm } from \'../data\';\nimport { Plane, Ship, Truck, FileText, Check, X, Clock } from \'lucide-react\';\n\nexport default function Quotes() {\n  const [showForm, setShowForm] = useState(false);\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Enviada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-info-bg text-info-text rounded-full text-[11px] font-medium w-fit\"><Clock className=\"w-3 h-3 mr-1\"/> Enviada</span>;\n      case \'Aceptada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-success-bg text-success-text rounded-full text-[11px] font-medium w-fit\"><Check className=\"w-3 h-3 mr-1\"/> Aceptada</span>;\n      case \'Rechazada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-neutral-bg text-neutral-text rounded-full text-[11px] font-medium w-fit\"><X className=\"w-3 h-3 mr-1\"/> Rechazada</span>;\n      case \'Vencida\': return <span className=\"flex items-center px-[10px] py-[4px] bg-danger-bg text-danger-text rounded-full text-[11px] font-medium w-fit\"><Clock className=\"w-3 h-3 mr-1\"/> Vencida</span>;\n      default: return null;\n    }\n  };\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Terrestre\': return <Truck className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className=\"space-y-[24px]\">\n      <div className=\"flex justify-between items-center mb-[24px]\">\n        <h2 className=\"text-[20px] font-semibold text-text-primary hidden\">Cotizaciones</h2>\n        <div className=\"flex-1\"></div>\n        <button \n          onClick={() => setShowForm(!showForm)}\n          className=\"bg-brand text-white px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover transition-colors shadow-sm\"\n        >\n          {showForm ? \'Volver al listado\' : \'Nueva Cotizaci\303\263n\'}\n        </button>\n      </div>\n\n      {showForm ? (\n        <div className=\"flex flex-col md:flex-row gap-[24px]\">\n          <div className=\"flex-[1.5] bg-card p-[24px] rounded-[12px] border border-card-border shadow-sm\">\n            <h3 className=\"text-[15px] font-semibold mb-[24px] text-text-primary\">Nueva Cotizaci\303\263n</h3>\n            <form className=\"space-y-[20px]\" onSubmit={(e) => { e.preventDefault(); alert(\'Cotizaci\303\263n generada correctamente.\'); setShowForm(false); }}>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[16px]\">\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Cliente</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                    <option value=\"\">Selecciona un cliente</option>\n                    {initialClients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Tipo</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                     {[\'A\303\251reo\', \'Mar\303\255timo\', \'Terrestre\'].map((type) => (\n                       <option key={type} value={type}>{type}</option>\n                     ))}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Origen</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" defaultValue=\"Shanghai (CNSHA)\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Destino</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" defaultValue=\"Manzanillo (MXZLO)\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Peso (KG)</label>\n                  <input type=\"number\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card tabular-nums\" defaultValue=\"12500\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Volumen (M3)</label>\n                  <input type=\"number\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card tabular-nums\" defaultValue=\"24\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Incoterm</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                    <option>CIF</option>\n                    <option>FOB</option>\n                    <option>EXW</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Notas</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" placeholder=\"Carga general\" />\n                </div>\n              </div>\n              \n              <div className=\"flex space-x-[12px] pt-[16px] border-t border-divider\">\n                <button \n                  type=\"button\" \n                  onClick={() => setShowForm(false)}\n                  className=\"px-[16px] py-[8px] border border-card-border bg-white text-text-primary rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg transition-colors\"\n                >\n                  Cancelar\n                </button>\n              </div>\n            </form>\n          </div>\n          \n          <div className=\"flex-1 bg-card p-[24px] rounded-[12px] border border-card-border shadow-sm self-start\">\n            <h4 className=\"font-semibold text-text-primary text-[15px] mb-[16px]\">Tarifas Disponibles</h4>\n            <div className=\"mb-[24px] flex flex-col space-y-0\">\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">Hapag-Lloyd</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,450 USD</strong>\n               </div>\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">MSC</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,380 USD</strong>\n               </div>\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">CMA CGM</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,510 USD</strong>\n               </div>\n            </div>\n            <button className=\"w-full bg-brand text-white font-medium text-[13px] py-[10px] rounded-[8px] hover:bg-brand-hover transition-colors shadow-sm\">\n              Generar cotizaci\303\263n PDF\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm overflow-hidden\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full border-collapse\">\n              <thead>\n                <tr>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Cotizaci\303\263n</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Cliente</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Detalles</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Fecha</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Valor</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Estatus</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-divider\">\n                {initialQuotes.map(quote => {\n                  const client = initialClients.find(c => c.id === quote.clientId)?.name;\n                  return (\n                    <tr key={quote.id} className=\"hover:bg-neutral-bg transition-colors\">\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary font-medium\">{quote.id}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary\">{client}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-secondary\">\n                        <div className=\"flex items-center\">\n                          {getTransportIcon(quote.type)}\n                          <span>{quote.origin} \342\206\222 {quote.destination}</span>\n                        </div>\n                      </td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-secondary tabular-nums\">{quote.date}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary tabular-nums font-medium\">${quote.total.toLocaleString()}</td>\n                      <td className=\"px-[24px] py-[16px]\">\n                        {getStatusBadge(quote.status)}\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
