    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\n\ninterface LoginProps {\n  onLogin: () => void;\n}\n\nexport default function Login({ onLogin }: LoginProps) {\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onLogin();\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-navy login-texture z-[100] flex items-center justify-center p-4\">\n      <div className=\"bg-white w-full max-w-[400px] rounded p-[40px] text-center shadow-lg\">\n        <div className=\"flex flex-col items-center mb-8\">\n          <img \n            src=\"https://firebasestorage.googleapis.com/v0/b/digsol-academy.firebasestorage.app/o/LOGOTIPO%20(1).png?alt=media&token=702db209-5869-4471-acb6-ac7740e5453b\"\n            alt=\"Vermur Logo\"\n            className=\"w-48 mb-3\"\n          />\n          <p className=\"text-gray-500 text-sm mb-[30px]\">El eslab\303\263n log\303\255stico de tu cadena de valor</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-5 text-left\">\n          <div>\n            <label className=\"block text-navy text-xs font-bold mb-1.5 uppercase\" htmlFor=\"email\">Correo Electr\303\263nico</label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              required\n              className=\"w-full bg-white border border-gray-200 rounded p-3 text-navy focus:outline-none focus:border-coral transition-colors\"\n              placeholder=\"operaciones@vermur.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-navy text-xs font-bold mb-1.5 uppercase\" htmlFor=\"password\">Contrase\303\261a</label>\n            <input\n              id=\"password\"\n              type=\"password\"\n              required\n              className=\"w-full bg-white border border-gray-200 rounded p-3 text-navy focus:outline-none focus:border-coral transition-colors\"\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"w-full bg-coral hover:bg-opacity-90 text-white text-[13px] font-semibold p-[14px] rounded transition-opacity uppercase\"\n          >\n            Ingresar\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { Check } from \'lucide-react\';\n\ninterface LoginProps {\n  onLogin: () => void;\n}\n\nexport default function Login({ onLogin }: LoginProps) {\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onLogin();\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-surface-dark login-texture z-[100] flex items-center justify-center p-4\">\n      <div className=\"bg-card w-full max-w-[400px] rounded-[12px] p-[40px] text-center shadow-lg border border-surface-border\">\n        <div className=\"flex flex-col items-center mb-[32px]\">\n           <div className=\"flex items-center text-[28px] font-semibold tracking-tight text-text-primary mb-[8px]\">\n             <span className=\"text-brand mr-[4px] flex items-center\">\n               <Check className=\"w-[32px] h-[32px] stroke-[3.5px]\" />\n             </span>\n             vermur\n           </div>\n          <p className=\"text-text-secondary text-[14px]\">El eslab\303\263n log\303\255stico de tu cadena de valor</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-[20px] text-left\">\n          <div>\n            <label className=\"block text-text-primary text-[12px] font-semibold mb-[6px] uppercase tracking-wide\">Correo Electr\303\263nico</label>\n            <input\n              id=\"email\"\n              type=\"email\"\n              required\n              className=\"w-full bg-card border border-card-border rounded-[8px] p-[12px] text-text-primary focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors text-[14px]\"\n              placeholder=\"operaciones@vermur.com\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n            />\n          </div>\n          <div>\n            <label className=\"block text-text-primary text-[12px] font-semibold mb-[6px] uppercase tracking-wide\">Contrase\303\261a</label>\n            <input\n              id=\"password\"\n              type=\"password\"\n              required\n              className=\"w-full bg-card border border-card-border rounded-[8px] p-[12px] text-text-primary focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors text-[14px]\"\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"w-full bg-brand hover:bg-brand-hover text-white text-[14px] font-semibold py-[12px] rounded-[8px] transition-colors\"\n          >\n            INGRESAR\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}"
    }
