    instruction: "Apply Clean Minimalism styling to Dashboard"
    replacement_infos {
      original_chunk {
        target_content: "  const getStatusColor = (status: string) => {\n    switch(status) {\n      case \'Entregado\': return \'bg-green-100 text-green-800\';\n      case \'En tr\303\241nsito\': return \'bg-blue-100 text-blue-800\';\n      case \'En aduana\': return \'bg-yellow-100 text-yellow-800\';\n      default: return \'bg-gray-100 text-gray-800\';\n    }\n  };\n\n  const pendingDocs = initialShipments.filter(s => s.documents.some(d => d.status === \'pending\'));\n\n  return (\n    <div className=\"space-y-6\">\n      <h2 className=\"text-2xl font-bold text-navy\">Dashboard Principal</h2>\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex items-center\">\n          <div className=\"bg-coral bg-opacity-10 p-3 rounded-full mr-4\">\n            <Package className=\"w-6 h-6 text-coral\" />\n          </div>\n          <div>\n            <p className=\"text-gray-500 text-sm\">Embarques activos</p>\n            <h3 className=\"text-2xl font-bold text-navy\">{activeShipments}</h3>\n          </div>\n        </div>\n        \n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex items-center\">\n          <div className=\"bg-blue-50 p-3 rounded-full mr-4\">\n            <FileText className=\"w-6 h-6 text-blue-600\" />\n          </div>\n          <div>\n            <p className=\"text-gray-500 text-sm\">Cotizaciones pdt.</p>\n            <h3 className=\"text-2xl font-bold text-navy\">{pendingQuotes}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex items-center\">\n          <div className=\"bg-green-50 p-3 rounded-full mr-4\">\n            <Users className=\"w-6 h-6 text-green-600\" />\n          </div>\n          <div>\n            <p className=\"text-gray-500 text-sm\">Clientes activos</p>\n            <h3 className=\"text-2xl font-bold text-navy\">{activeClients}</h3>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex items-center\">\n          <div className=\"bg-purple-50 p-3 rounded-full mr-4\">\n            <DollarSign className=\"w-6 h-6 text-purple-600\" />\n          </div>\n          <div>\n            <p className=\"text-gray-500 text-sm\">Ingresos (Mes)</p>\n            <h3 className=\"text-2xl font-bold text-navy\">${monthlyRevenue.toLocaleString()}</h3>\n          </div>\n        </div>\n      </div>\n\n      {pendingDocs.length > 0 && (\n        <div className=\"bg-white border-l-4 border-coral p-4 shadow-sm rounded-r-lg\">\n          <div className=\"flex items-center text-coral mb-2\">\n            <AlertCircle className=\"w-5 h-5 mr-2\" />\n            <h4 className=\"font-bold\">Alertas de Documentaci\303\263n</h4>\n          </div>\n          <ul className=\"space-y-1 text-sm text-gray-700\">\n            {pendingDocs.map(shp => {\n              const pending = shp.documents.filter(d => d.status === \'pending\').map(d => d.name).join(\', \');\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <li key={shp.id}>\n                  <strong>{shp.id}</strong> ({client}): Falta {pending}\n                </li>\n              );\n            })}\n          </ul>\n        </div>\n      )}\n\n      <div className=\"bg-white shadow-sm rounded-lg border border-gray-100 overflow-hidden\">\n        <div className=\"px-6 py-4 border-b border-gray-100 bg-gray-50\">\n          <h3 className=\"font-bold text-navy\">Embarques Recientes</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm whitespace-nowrap\">\n            <thead className=\"bg-white text-gray-500 border-b border-gray-100\">\n              <tr>\n                <th className=\"px-6 py-3 font-medium\"># Embarque</th>\n                <th className=\"px-6 py-3 font-medium\">Cliente</th>\n                <th className=\"px-6 py-3 font-medium\">Origen / Destino</th>\n                <th className=\"px-6 py-3 font-medium\">Fecha Est.</th>\n                <th className=\"px-6 py-3 font-medium\">Estatus</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-gray-100\">\n              {initialShipments.map(shp => {\n                const client = initialClients.find(c => c.id === shp.clientId)?.name;\n                return (\n                  <tr key={shp.id} className=\"hover:bg-gray-50 transition-colors\">\n                    <td className=\"px-6 py-4 font-medium text-navy\">{shp.id}</td>\n                    <td className=\"px-6 py-4 text-gray-700\">{client}</td>\n                    <td className=\"px-6 py-4 text-gray-600\">\n                      <div>{shp.origin}</div>\n                      <div className=\"text-gray-400 text-xs\">\342\206\222 {shp.destination}</div>\n                    </td>\n                    <td className=\"px-6 py-4 text-gray-600\">{shp.eta}</td>\n                    <td className=\"px-6 py-4\">\n                      <span className={`px-2.5 py-1 rounded-full text-xs font-medium ${getStatusColor(shp.status)}`}>\n                        {shp.status}\n                      </span>\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>"
        replacement_content: "  const getStatusColor = (status: string) => {\n    switch(status) {\n      case \'Entregado\': return \'bg-success/10 text-success\';\n      case \'En tr\303\241nsito\': return \'bg-success/10 text-success\';\n      case \'En aduana\': return \'bg-warning/10 text-warning\';\n      default: return \'bg-coral text-white\';\n    }\n  };\n\n  const pendingDocs = initialShipments.filter(s => s.documents.some(d => d.status === \'pending\'));\n\n  return (\n    <div className=\"space-y-0\">\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] mb-[25px]\">\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Embarques Activos</div>\n          <div className=\"text-[24px] font-bold\">{activeShipments}</div>\n        </div>\n        \n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Cotizaciones pdt.</div>\n          <div className=\"text-[24px] font-bold\">{pendingQuotes}</div>\n        </div>\n\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Clientes Activos</div>\n          <div className=\"text-[24px] font-bold\">{activeClients}</div>\n        </div>\n\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Ingresos Mes (USD)</div>\n          <div className=\"text-[24px] font-bold\">${monthlyRevenue.toLocaleString()}</div>\n        </div>\n      </div>\n\n      {pendingDocs.length > 0 && (\n        <div className=\"bg-white border-l-4 border-coral py-[15px] px-[20px] shadow-sm mb-[25px] flex items-center justify-between\">\n          <div className=\"flex items-center text-[14px]\">\n            <strong className=\"text-coral mr-2 uppercase\">ALERTA OPERATIVA:</strong>\n            <span className=\"text-navy\">{pendingDocs.length} embarques requieren documentaci\303\263n.</span>\n          </div>\n          <button className=\"bg-coral text-white px-[16px] py-[8px] rounded text-[13px] font-semibold\">\n            Revisar\n          </button>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded shadow-sm overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full border-collapse\">\n            <thead>\n              <tr>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\"># Embarque</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Cliente</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Origen / Destino</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Estatus</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Fecha Est.</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-gray-100\">\n              {initialShipments.map(shp => {\n                const client = initialClients.find(c => c.id === shp.clientId)?.name;\n                return (\n                  <tr key={shp.id}>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{shp.id}</td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{client}</td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">\n                      {shp.origin.split(\',\')[0]} \342\206\222 {shp.destination.split(\',\')[0]}\n                    </td>\n                    <td className=\"px-[20px] py-[14px] border-b border-gray-100\">\n                      <span className={`px-[10px] py-[4px] rounded-[20px] text-[11px] font-semibold uppercase ${getStatusColor(shp.status)}`}>\n                        {shp.status}\n                      </span>\n                    </td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{shp.eta}</td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>"
      }
