      target_content: "import React, { useState } from \'react\';\nimport { initialQuotes, initialClients, TransportType, Incoterm } from \'../data\';\nimport { Plane, Ship, Truck, FileText, Check, X, Clock } from \'lucide-react\';\n\nexport default function Quotes() {\n  const [showForm, setShowForm] = useState(false);\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Enviada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-info-bg text-info-text rounded-full text-[11px] font-medium w-fit\"><Clock className=\"w-3 h-3 mr-1\"/> Enviada</span>;\n      case \'Aceptada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-success-bg text-success-text rounded-full text-[11px] font-medium w-fit\"><Check className=\"w-3 h-3 mr-1\"/> Aceptada</span>;\n      case \'Rechazada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-neutral-bg text-neutral-text rounded-full text-[11px] font-medium w-fit\"><X className=\"w-3 h-3 mr-1\"/> Rechazada</span>;\n      case \'Vencida\': return <span className=\"flex items-center px-[10px] py-[4px] bg-danger-bg text-danger-text rounded-full text-[11px] font-medium w-fit\"><Clock className=\"w-3 h-3 mr-1\"/> Vencida</span>;\n      default: return null;\n    }\n  };\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Terrestre\': return <Truck className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className=\"space-y-[24px]\">\n      <div className=\"flex justify-between items-center mb-[24px]\">\n        <h2 className=\"text-[20px] font-semibold text-text-primary hidden\">Cotizaciones</h2>\n        <div className=\"flex-1\"></div>\n        <button \n          onClick={() => setShowForm(!showForm)}\n          className=\"bg-brand text-white px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover transition-colors shadow-sm\"\n        >\n          {showForm ? \'Volver al listado\' : \'Nueva Cotizaci\303\263n\'}\n        </button>\n      </div>\n\n      {showForm ? (\n        <div className=\"flex flex-col md:flex-row gap-[24px]\">\n          <div className=\"flex-[1.5] bg-card p-[24px] rounded-[12px] border border-card-border shadow-sm\">\n            <h3 className=\"text-[15px] font-semibold mb-[24px] text-text-primary\">Nueva Cotizaci\303\263n</h3>\n            <form className=\"space-y-[20px]\" onSubmit={(e) => { e.preventDefault(); alert(\'Cotizaci\303\263n generada correctamente.\'); setShowForm(false); }}>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[16px]\">\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Cliente</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                    <option value=\"\">Selecciona un cliente</option>\n                    {initialClients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Tipo</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                     {[\'A\303\251reo\', \'Mar\303\255timo\', \'Terrestre\'].map((type) => (\n                       <option key={type} value={type}>{type}</option>\n                     ))}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Origen</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" defaultValue=\"Shanghai (CNSHA)\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Destino</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" defaultValue=\"Manzanillo (MXZLO)\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Peso (KG)</label>\n                  <input type=\"number\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card tabular-nums\" defaultValue=\"12500\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Volumen (M3)</label>\n                  <input type=\"number\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card tabular-nums\" defaultValue=\"24\" />\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Incoterm</label>\n                  <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\">\n                    <option>CIF</option>\n                    <option>FOB</option>\n                    <option>EXW</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-text-primary text-[11px] font-semibold tracking-[0.05em] mb-[8px] uppercase\">Notas</label>\n                  <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-card\" placeholder=\"Carga general\" />\n                </div>\n              </div>\n              \n              <div className=\"flex space-x-[12px] pt-[16px] border-t border-divider\">\n                <button \n                  type=\"button\" \n                  onClick={() => setShowForm(false)}\n                  className=\"px-[16px] py-[8px] border border-card-border bg-white text-text-primary rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg transition-colors\"\n                >\n                  Cancelar\n                </button>\n              </div>\n            </form>\n          </div>\n          \n          <div className=\"flex-1 bg-card p-[24px] rounded-[12px] border border-card-border shadow-sm self-start\">\n            <h4 className=\"font-semibold text-text-primary text-[15px] mb-[16px]\">Tarifas Disponibles</h4>\n            <div className=\"mb-[24px] flex flex-col space-y-0\">\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">Hapag-Lloyd</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,450 USD</strong>\n               </div>\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">MSC</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,380 USD</strong>\n               </div>\n               <div className=\"py-[12px] border-b border-divider flex justify-between text-[13px]\">\n                 <span className=\"text-text-secondary\">CMA CGM</span>\n                 <strong className=\"text-text-primary tabular-nums\">$2,510 USD</strong>\n               </div>\n            </div>\n            <button className=\"w-full bg-brand text-white font-medium text-[13px] py-[10px] rounded-[8px] hover:bg-brand-hover transition-colors shadow-sm\">\n              Generar cotizaci\303\263n PDF\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm overflow-hidden\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full border-collapse\">\n              <thead>\n                <tr>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Cotizaci\303\263n</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Cliente</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Detalles</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Fecha</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Valor</th>\n                  <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase tracking-[0.05em] font-medium text-text-muted border-b border-divider\">Estatus</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-divider\">\n                {initialQuotes.map(quote => {\n                  const client = initialClients.find(c => c.id === quote.clientId)?.name;\n                  return (\n                    <tr key={quote.id} className=\"hover:bg-neutral-bg transition-colors\">\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary font-medium\">{quote.id}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary\">{client}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-secondary\">\n                        <div className=\"flex items-center\">\n                          {getTransportIcon(quote.type)}\n                          <span>{quote.origin} \342\206\222 {quote.destination}</span>\n                        </div>\n                      </td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-secondary tabular-nums\">{quote.date}</td>\n                      <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary tabular-nums font-medium\">${quote.total.toLocaleString()}</td>\n                      <td className=\"px-[24px] py-[16px]\">\n                        {getStatusBadge(quote.status)}\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { initialQuotes, initialClients, TransportType, Incoterm } from \'../data\';\nimport { Plane, Ship, Truck, Check, X, Clock, MoreVertical, Plus, Trash2, Search, Filter } from \'lucide-react\';\n\nexport default function Quotes() {\n  const [showForm, setShowForm] = useState(false);\n  const [activeMenu, setActiveMenu] = useState<string | null>(null);\n\n  const [lineItems, setLineItems] = useState([\n    { id: 1, concept: \'Flete principal\', base: 1, rate: 1200, currency: \'USD\', total: 1200 },\n    { id: 2, concept: \'Despacho aduanal\', base: 1, rate: 150, currency: \'USD\', total: 150 },\n  ]);\n\n  const [margin, setMargin] = useState(20);\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Enviada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-info-bg text-info-text rounded-[6px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap\"><Clock className=\"w-3 h-3 mr-1\"/> Enviada</span>;\n      case \'Aceptada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-success-bg text-success-text rounded-[6px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap\"><Check className=\"w-3 h-3 mr-1\"/> Aceptada</span>;\n      case \'Rechazada\': return <span className=\"flex items-center px-[10px] py-[4px] bg-neutral-bg text-neutral-text rounded-[6px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap\"><X className=\"w-3 h-3 mr-1\"/> Rechazada</span>;\n      case \'Vencida\': return <span className=\"flex items-center px-[10px] py-[4px] bg-danger-bg text-danger-text rounded-[6px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap\"><Clock className=\"w-3 h-3 mr-1\"/> Vencida</span>;\n      default: return null;\n    }\n  };\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      case \'Terrestre\': return <Truck className=\"w-4 h-4 mr-2 text-text-muted\" />;\n      default: return null;\n    }\n  };\n\n  const toggleMenu = (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setActiveMenu(activeMenu === id ? null : id);\n  };\n\n  const handleAddLine = () => {\n    setLineItems([...lineItems, { id: Date.now(), concept: \'\', base: 1, rate: 0, currency: \'USD\', total: 0 }]);\n  };\n\n  const handleRemoveLine = (id: number) => {\n    setLineItems(lineItems.filter(item => item.id !== id));\n  };\n\n  const updateLine = (id: number, field: string, value: string | number) => {\n    setLineItems(lineItems.map(item => {\n      if (item.id === id) {\n        const updated = { ...item, [field]: value };\n        if (field === \'base\' || field === \'rate\') {\n          updated.total = Number(updated.base) * Number(updated.rate);\n        }\n        return updated;\n      }\n      return item;\n    }));\n  };\n\n  const subtotal = lineItems.reduce((acc, curr) => acc + curr.total, 0);\n  const marginAmount = subtotal * (margin / 100);\n  const finalTotal = subtotal + marginAmount;\n\n  return (\n    <div className=\"space-y-[24px]\" onClick={() => setActiveMenu(null)}>\n      \n      {!showForm && (\n        <div className=\"flex flex-col sm:flex-row justify-between sm:items-center mb-[24px] gap-[16px]\">\n          <h2 className=\"text-[24px] font-semibold text-text-primary tracking-tight\">Cotizaciones</h2>\n          <button \n            onClick={() => setShowForm(true)}\n            className=\"bg-brand text-white px-[16px] py-[10px] rounded-[8px] text-[13px] font-medium hover:bg-brand-hover transition-colors shadow-sm\"\n          >\n            Nueva cotizaci\303\263n\n          </button>\n        </div>\n      )}\n\n      {showForm ? (\n        <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm flex flex-col\">\n          <div className=\"px-[32px] py-[24px] border-b border-divider flex justify-between items-center\">\n            <h3 className=\"text-[18px] font-semibold text-text-primary tracking-tight\">Crear nueva cotizaci\303\263n</h3>\n            <button onClick={() => setShowForm(false)} className=\"text-[13px] text-text-secondary hover:text-text-primary font-medium transition-colors\">Volver</button>\n          </div>\n          \n          <div className=\"p-[32px] flex-1\">\n            <h4 className=\"text-[13px] font-semibold text-text-primary mb-[16px] border-b border-divider pb-[8px]\">Datos Generales</h4>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-[20px] mb-[32px]\">\n              <div className=\"lg:col-span-2\">\n                <label className=\"block text-text-primary text-[11px] font-medium mb-[8px]\">Cliente</label>\n                <div className=\"relative\">\n                  <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n                  <input type=\"text\" placeholder=\"Buscar cliente...\" className=\"w-full pl-[36px] border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-canvas shadow-sm\" />\n                </div>\n              </div>\n              <div className=\"lg:col-span-1\">\n                <label className=\"block text-text-primary text-[11px] font-medium mb-[8px]\">Modo</label>\n                <select className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-canvas shadow-sm\">\n                  {[\'A\303\251reo\', \'Mar\303\255timo\', \'Terrestre\'].map((type) => (\n                    <option key={type} value={type}>{type}</option>\n                  ))}\n                </select>\n              </div>\n              <div className=\"lg:col-span-1\">\n                <label className=\"block text-text-primary text-[11px] font-medium mb-[8px]\">Origen</label>\n                <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-canvas shadow-sm\" placeholder=\"Ej. Shanghai\" />\n              </div>\n              <div className=\"lg:col-span-1\">\n                <label className=\"block text-text-primary text-[11px] font-medium mb-[8px]\">Destino</label>\n                <input type=\"text\" className=\"w-full border border-card-border rounded-[8px] p-[10px] focus:border-brand focus:ring-1 focus:ring-brand focus:outline-none text-[13px] text-text-primary bg-canvas shadow-sm\" placeholder=\"Ej. Manzanillo\" />\n              </div>\n            </div>\n\n            <div className=\"flex justify-between items-center border-b border-divider pb-[8px] mb-[16px]\">\n               <h4 className=\"text-[13px] font-semibold text-text-primary\">L\303\255neas de cargos</h4>\n               <button onClick={handleAddLine} className=\"flex items-center text-[12px] font-medium text-brand hover:text-brand-hover transition-colors\">\n                 <Plus className=\"w-4 h-4 mr-1\" />\n                 Agregar cargo\n               </button>\n            </div>\n            \n            <div className=\"overflow-x-auto mb-[32px]\">\n              <table className=\"w-full border-collapse\">\n                <thead>\n                  <tr>\n                    <th className=\"bg-canvas text-left px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider w-2/5\">Concepto</th>\n                    <th className=\"bg-canvas text-left px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider\">Base / Unidades</th>\n                    <th className=\"bg-canvas text-left px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider\">Tarifa</th>\n                    <th className=\"bg-canvas text-left px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider\">Moneda</th>\n                    <th className=\"bg-canvas text-right px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider\">Total</th>\n                    <th className=\"bg-canvas text-center px-[16px] py-[10px] text-[11px] font-medium text-text-muted border-y border-divider w-[40px]\"></th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-divider\">\n                  {lineItems.map(item => (\n                    <tr key={item.id}>\n                      <td className=\"px-[12px] py-[12px]\">\n                        <input type=\"text\" value={item.concept} onChange={(e) => updateLine(item.id, \'concept\', e.target.value)} className=\"w-full border border-transparent hover:border-card-border focus:border-brand rounded-[6px] px-[8px] py-[6px] text-[13px] bg-transparent outline-none transition-colors\" placeholder=\"Descripci\303\263n del cargo\" />\n                      </td>\n                      <td className=\"px-[12px] py-[12px]\">\n                        <input type=\"number\" value={item.base} onChange={(e) => updateLine(item.id, \'base\', Number(e.target.value))} className=\"w-full border border-transparent hover:border-card-border focus:border-brand rounded-[6px] px-[8px] py-[6px] text-[13px] bg-transparent outline-none transition-colors tabular-nums\" />\n                      </td>\n                      <td className=\"px-[12px] py-[12px]\">\n                        <input type=\"number\" value={item.rate} onChange={(e) => updateLine(item.id, \'rate\', Number(e.target.value))} className=\"w-full border border-transparent hover:border-card-border focus:border-brand rounded-[6px] px-[8px] py-[6px] text-[13px] bg-transparent outline-none transition-colors tabular-nums\" />\n                      </td>\n                      <td className=\"px-[12px] py-[12px]\">\n                        <select value={item.currency} onChange={(e) => updateLine(item.id, \'currency\', e.target.value)} className=\"w-full border border-transparent hover:border-card-border focus:border-brand rounded-[6px] px-[8px] py-[6px] text-[13px] bg-transparent outline-none transition-colors\">\n                          <option>USD</option>\n                          <option>MXN</option>\n                          <option>EUR</option>\n                        </select>\n                      </td>\n                      <td className=\"px-[16px] py-[12px] text-right text-[13px] text-text-primary font-medium tabular-nums\">\n                        ${item.total.toLocaleString(undefined, {minimumFractionDigits: 2})}\n                      </td>\n                      <td className=\"px-[8px] py-[12px] text-center\">\n                        <button onClick={() => handleRemoveLine(item.id)} className=\"text-text-muted hover:text-danger-text transition-colors p-[4px] rounded-[4px]\">\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n\n            <div className=\"flex justify-end mb-[32px]\">\n              <div className=\"w-full max-w-[320px] bg-canvas rounded-[8px] border border-card-border p-[20px]\">\n                <div className=\"flex justify-between items-center mb-[12px] text-[13px]\">\n                   <span className=\"text-text-secondary\">Subtotal Cargas</span>\n                   <span className=\"text-text-primary font-medium tabular-nums\">${subtotal.toLocaleString(undefined, {minimumFractionDigits: 2})}</span>\n                </div>\n                <div className=\"flex justify-between items-center mb-[16px] text-[13px]\">\n                   <span className=\"text-text-secondary flex items-center\">\n                     Margen Objetivo\n                     <input type=\"number\" value={margin} onChange={(e) => setMargin(Number(e.target.value))} className=\"ml-[8px] w-[50px] border border-card-border rounded-[4px] px-[6px] py-[2px] text-center outline-none focus:border-brand\" /> %\n                   </span>\n                   <span className=\"text-text-primary font-medium tabular-nums\">${marginAmount.toLocaleString(undefined, {minimumFractionDigits: 2})}</span>\n                </div>\n                <div className=\"flex justify-between items-center pt-[16px] border-t border-divider\">\n                   <span className=\"text-[14px] font-semibold text-text-primary\">Total Cotizaci\303\263n</span>\n                   <span className=\"text-[18px] font-bold text-text-primary tabular-nums\">${finalTotal.toLocaleString(undefined, {minimumFractionDigits: 2})} USD</span>\n                </div>\n              </div>\n            </div>\n\n          </div>\n          \n          <div className=\"px-[32px] py-[24px] border-t border-divider bg-canvas rounded-b-[12px] flex justify-end space-x-[12px]\">\n            <button \n              onClick={() => setShowForm(false)}\n              className=\"px-[16px] py-[10px] border border-card-border bg-white text-text-primary rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg transition-colors shadow-sm\"\n            >\n              Guardar borrador\n            </button>\n            <button \n              onClick={() => { alert(\'Cotizaci\303\263n enviada correcta.\'); setShowForm(false); }}\n              className=\"px-[16px] py-[10px] bg-brand text-white rounded-[8px] text-[13px] font-medium hover:bg-brand-hover transition-colors shadow-sm\"\n            >\n              Enviar al cliente\n            </button>\n          </div>\n        </div>\n      ) : (\n        <>\n          <div className=\"flex gap-[12px] items-center mb-[24px]\">\n            <div className=\"relative max-w-[300px] flex-1\">\n              <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input type=\"text\" placeholder=\"Filtrar cotizaciones...\" className=\"w-full pl-[36px] bg-card border border-card-border rounded-[8px] p-[8px] text-[13px] focus:outline-none focus:border-brand shadow-sm text-text-primary\" />\n            </div>\n            <button className=\"flex items-center text-[13px] font-medium text-text-secondary bg-white border border-card-border rounded-[8px] px-[12px] py-[8px] hover:bg-neutral-bg transition-colors shadow-sm\">\n              <Filter className=\"w-4 h-4 mr-2\" /> Faltros\n            </button>\n          </div>\n\n          <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm overflow-visible\">\n            <div className=\"overflow-visible min-h-[300px]\">\n              <table className=\"w-full border-collapse\">\n                <thead>\n                  <tr>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Cotizaci\303\263n</th>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Cliente</th>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Detalles</th>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Fecha</th>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Validez</th>\n                    <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] font-medium text-text-muted border-b border-divider\">Valor</th>\n                    <th className=\"bg-canvas text-left px-[24px] 