n()\\\" class=\\\"btn btn-primary\\\" style=\\\"width:100%;padding:14px\\\">INGRESAR</button></div></div><div class=\\\"container\\\"><div class=\\\"sidebar\\\"><div class=\\\"logo-area\\\"><span class=\\\"logo-v\\\">V</span><span class=\\\"logo-text\\\">ermur</span></div><div class=\\\"nav-menu\\\"><div class=\\\"nav-item active\\\" onclick=\\\"view(\'dash\')\\\">Dashboard</div><div class=\\\"nav-item\\\" onclick=\\\"view(\'quotes\')\\\">Cotizaciones</div><div class=\\\"nav-item\\\" onclick=\\\"view(\'ship\')\\\">Embarques</div><div class=\\\"nav-item\\\" onclick=\\\"view(\'clients\')\\\">Clientes</div><div class=\\\"nav-item\\\">Reportes</div></div><div style=\\\"padding:20px;font-size:11px;opacity:.5\\\">VermurOps v2.4</div></div><div class=\\\"main-content\\\"><div class=\\\"top-header\\\"><div><span style=\\\"font-weight:600;font-size:18px\\\">Dashboard Principal</span></div><div style=\\\"display:flex;gap:20px;align-items:center;font-size:13px\\\"><span>Admin Vermur</span><button onclick=\\\"location.reload()\\\" style=\\\"background:none;border:none;color:white;cursor:pointer;opacity:.7\\\">Cerrar Sesi\303\263n</button></div></div><div id=\\\"view-dash\\\" class=\\\"view-container active\\\"><div class=\\\"kpi-grid\\\"><div class=\\\"kpi-card\\\"><div class=\\\"kpi-label\\\">Embarques Activos</div><div class=\\\"kpi-value\\\">24</div></div><div class=\\\"kpi-card\\\"><div class=\\\"kpi-label\\\">Cotizaciones Pend.</div><div class=\\\"kpi-value\\\">12</div></div><div class=\\\"kpi-card\\\"><div class=\\\"kpi-label\\\">Clientes Activos</div><div class=\\\"kpi-value\\\">86</div></div><div class=\\\"kpi-card\\\"><div class=\\\"kpi-label\\\">Ingresos Mes (USD)</div><div class=\\\"kpi-value\\\">$142,500</div></div></div><div class=\\\"alert-bar\\\"><div><strong style=\\\"color:var(--coral)\\\">ALERTA OPERATIVA:</strong> 3 embarques requieren documentaci\303\263n de pedimento inmediata.</div><button class=\\\"btn btn-primary\\\">Revisar</button></div><div class=\\\"