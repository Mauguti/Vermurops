    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { initialShipments, initialClients, Shipment } from \'../data\';\nimport { Search, Filter, Anchor, Package, CheckCircle2, ChevronRight, File } from \'lucide-react\';\n\nexport default function Shipments() {\n  const [selectedShipment, setSelectedShipment] = useState<Shipment | null>(null);\n\n  const steps = [\'Cotizado\', \'Confirmado\', \'En tr\303\241nsito\', \'En aduana\', \'Entregado\'];\n\n  return (\n    <div className=\"space-y-[24px]\">\n      {!selectedShipment ? (\n        <>\n          <div className=\"flex justify-between items-center hidden\">\n            <h2 className=\"text-[20px] font-semibold text-text-primary\">Embarques</h2>\n          </div>\n\n          <div className=\"flex space-x-[12px] bg-card p-[16px] rounded-[12px] border border-card-border shadow-sm mb-[24px]\">\n            <div className=\"flex-1 relative\">\n              <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por cliente, origen, destino, ID...\" \n                className=\"w-full pl-[36px] outline-none text-[14px] text-text-primary bg-transparent\"\n              />\n            </div>\n            <button className=\"flex items-center px-[16px] py-[8px] bg-card border border-card-border rounded-[8px] text-[13px] font-medium text-text-primary hover:bg-neutral-bg transition-colors\">\n              <Filter className=\"w-4 h-4 mr-2\" />\n              Filtros\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]\">\n            {initialShipments.map(shp => {\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <div \n                  key={shp.id} \n                  onClick={() => setSelectedShipment(shp)}\n                  className=\"bg-card border border-card-border rounded-[12px] cursor-pointer hover:border-brand/30 hover:shadow-md transition-all group flex flex-col shadow-sm\"\n                >\n                  <div className=\"border-b border-divider p-[24px] flex justify-between items-center\">\n                    <span className=\"font-semibold text-text-primary flex items-center text-[15px]\">\n                      <Anchor className=\"w-4 h-4 mr-2 text-text-muted transition-colors group-hover:text-brand\"/>\n                      {shp.id}\n                    </span>\n                    <span className=\"text-[11px] tracking-[0.05em] font-medium px-[10px] py-[4px] bg-neutral-bg text-text-secondary rounded-full uppercase\">\n                      {shp.type}\n                    </span>\n                  </div>\n                  <div className=\"px-[24px] py-[20px] space-y-[16px] flex-1\">\n                    <div>\n                      <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mb-[4px]\">Cliente</div>\n                      <div className=\"font-medium text-text-primary text-[14px]\">{client}</div>\n                    </div>\n                    \n                    <div className=\"flex items-center pt-[4px]\">\n                       <div className=\"flex-1\">\n                          <div className=\"font-medium text-text-primary text-[14px] truncate\">{shp.origin.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mt-[2px]\">Origen</div>\n                       </div>\n                       <div className=\"px-3 text-text-muted\">\342\206\222</div>\n                       <div className=\"flex-1 text-right\">\n                          <div className=\"font-medium text-text-primary text-[14px] truncate\">{shp.destination.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mt-[2px]\">Destino</div>\n                       </div>\n                    </div>\n\n                    <div className=\"pt-[16px] border-t border-divider text-[13px] flex justify-between items-center\">\n                      <span className=\"text-text-primary font-medium flex items-center\">\n                        <Package className=\"w-4 h-4 mr-2 text-text-muted transition-colors group-hover:text-brand\"/>\n                        {shp.status}\n                      </span>\n                      <span className=\"text-text-secondary tabular-nums\">ETA: {shp.eta}</span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-[24px]\">\n          <div className=\"flex items-center space-x-2 text-[13px] text-text-secondary mb-[8px]\">\n            <button onClick={() => setSelectedShipment(null)} className=\"hover:text-text-primary transition-colors\">Embarques</button>\n            <ChevronRight className=\"w-4 h-4 text-text-muted\" />\n            <span className=\"text-text-primary font-medium\">{selectedShipment.id}</span>\n          </div>\n          \n          <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm p-[32px]\">\n            <div className=\"flex justify-between items-start mb-[32px]\">\n              <div>\n                <h3 className=\"text-[24px] font-semibold text-text-primary mb-[4px]\">{selectedShipment.id}</h3>\n                <p className=\"text-text-secondary text-[14px]\">{initialClients.find(c => c.id === selectedShipment.clientId)?.name}</p>\n              </div>\n              <div className=\"text-right border border-card-border rounded-[8px] p-[16px] bg-canvas\">\n                <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mb-1\">Carrier</div>\n                <div className=\"font-medium text-text-primary text-[15px] mb-[4px]\">{selectedShipment.carrier}</div>\n                <div className=\"text-[11px] tracking-[0.05em] text-text-muted uppercase font-medium\">Incoterm: {selectedShipment.incoterm}</div>\n              </div>\n            </div>\n\n            {/* Timeline visual */}\n            <div className=\"mb-[40px] w-full relative\">\n              <div className=\"overflow-hidden h-[4px] mb-[16px] text-xs flex rounded-full bg-divider\">\n                <div style={{ width: `${(selectedShipment.timelineStep / (steps.length - 1)) * 100}%` }} className=\"shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-brand transition-all duration-500\"></div>\n              </div>\n              <div className=\"flex justify-between text-[12px] font-medium text-text-muted -mx-4 sm:mx-0\">\n                {steps.map((step, idx) => (\n                  <div key={idx} className={`flex flex-col items-center ${idx <= selectedShipment.timelineStep ? \'text-text-primary\' : \'\'} w-1/5 text-center`}>\n                     {idx <= selectedShipment.timelineStep ? <CheckCircle2 className=\"w-[18px] h-[18px] mb-[8px] text-brand\" /> : <div className=\"w-[18px] h-[18px] mb-[8px] rounded-full border-2 border-divider\" />}\n                     <span className=\"hidden sm:inline\">{step}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[32px]\">\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-text-primary border-b border-divider pb-[8px] mb-[16px]\">Documentaci\303\263n</h4>\n                 <ul className=\"space-y-[12px]\">\n                   {selectedShipment.documents.map((doc, idx) => (\n                     <li key={idx} className=\"flex items-center justify-between p-[16px] bg-canvas rounded-[8px] border border-card-border\">\n                       <span className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                         <File className=\"w-4 h-4 mr-3 text-text-muted\" />\n                         {doc.name}\n                       </span>\n                       {doc.status === \'ok\' ? (\n                         <span className=\"text-[11px] font-medium tracking-[0.05em] px-[10px] py-[4px] bg-success-bg text-success-text rounded-full uppercase\">Cargado</span>\n                       ) : (\n                         <button className=\"text-[11px] font-medium tracking-[0.05em] px-[12px] py-[6px] border border-brand text-brand rounded-[6px] hover:bg-brand hover:text-white transition-colors uppercase\">\n                           Subir\n                         </button>\n                       )}\n                     </li>\n                   ))}\n                 </ul>\n               </div>\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-text-primary border-b border-divider pb-[8px] mb-[16px]\">Notas Operativas</h4>\n                 <div className=\"bg-warning-bg border border-warning-bg p-[16px] rounded-[8px] text-[13px] text-warning-text h-[calc(100%-40px)]\">\n                    {selectedShipment.notes}\n                 </div>\n               </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { initialShipments, initialClients, Shipment } from \'../data\';\nimport { Search, Filter, Anchor, Package, CheckCircle2, ChevronRight, File, ArrowRight, MapPin, Building2, User, FileText, ChevronDown, Check, Circle, ExternalLink, Ship, Plane, Truck } from \'lucide-react\';\n\nexport default function Shipments() {\n  const [selectedShipment, setSelectedShipment] = useState<Shipment | null>(null);\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [activeFilter, setActiveFilter] = useState(\'Todos\');\n  const [activeTab, setActiveTab] = useState(\'Resumen\');\n\n  const steps = [\'Reservado\', \'Recolectado\', \'En tr\303\241nsito\', \'En aduana\', \'Entregado\'];\n  const detailTabs = [\'Resumen\', \'Carga\', \'Documentos\', \'Aduana\', \'Costos\', \'Actividad\'];\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-[14px] h-[14px] mr-[6px]\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-[14px] h-[14px] mr-[6px]\" />;\n      case \'Terrestre\': return <Truck className=\"w-[14px] h-[14px] mr-[6px]\" />;\n      default: return null;\n    }\n  };\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Reservado\': return <span className=\"px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap bg-neutral-bg text-text-secondary\">Reservado</span>;\n      case \'Recolectado\': return <span className=\"px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap bg-info-bg text-info-text\">Recolectado</span>;\n      case \'En tr\303\241nsito\': return <span className=\"px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap bg-info-bg text-info-text\">En tr\303\241nsito</span>;\n      case \'En aduana\': return <span className=\"px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap bg-warning-bg text-warning-text\">En aduana</span>;\n      case \'Entregado\': return <span className=\"px-[8px] py-[2px] rounded-[4px] text-[11px] font-medium tracking-[0.02em] whitespace-nowrap bg-success-bg text-success-text\">Entregado</span>;\n      default: return null;\n    }\n  };\n\n  const filteredShipments = initialShipments.filter(shp => {\n    const matchesSearch = shp.id.toLowerCase().includes(searchTerm.toLowerCase()) || \n                          shp.origin.toLowerCase().includes(searchTerm.toLowerCase()) || \n                          shp.destination.toLowerCase().includes(searchTerm.toLowerCase());\n    const matchesFilter = activeFilter === \'Todos\' || shp.type === activeFilter;\n    return matchesSearch && matchesFilter;\n  });\n\n  return (\n    <div className=\"space-y-[24px]\">\n      {!selectedShipment ? (\n        <>\n          <div className=\"flex flex-col sm:flex-row justify-between sm:items-center gap-[16px] mb-[24px]\">\n            <h2 className=\"text-[24px] font-semibold text-text-primary tracking-tight\">Embarques</h2>\n            <div className=\"flex space-x-[8px]\">\n               {[\'Todos\', \'Mar\303\255timo\', \'A\303\251reo\', \'Terrestre\'].map(filter => (\n                 <button \n                   key={filter}\n                   onClick={() => setActiveFilter(filter)}\n                   className={`px-[12px] py-[6px] rounded-[6px] text-[12px] font-medium transition-colors ${activeFilter === filter ? \'bg-text-primary text-white\' : \'bg-white border border-card-border text-text-secondary hover:bg-neutral-bg\'}`}\n                 >\n                   {filter}\n                 </button>\n               ))}\n            </div>\n          </div>\n\n          <div className=\"flex gap-[12px] items-center mb-[24px]\">\n            <div className=\"relative max-w-[480px] flex-1\">\n              <Search className=\"w-[16px] h-[16px] absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por cliente, origen, destino, ID...\" \n                value={searchTerm}\n                onChange={(e) => setSearchTerm(e.target.value)}\n                className=\"w-full pl-[36px] outline-none text-[13px] text-text-primary bg-card border border-card-border rounded-[8px] px-[12px] py-[10px] focus:border-brand shadow-sm\"\n              />\n            </div>\n            <button className=\"flex items-center px-[16px] py-[10px] bg-white border border-card-border rounded-[8px] text-[13px] font-medium text-text-primary hover:bg-neutral-bg transition-colors shadow-sm shrink-0\">\n              <Filter className=\"w-[16px] h-[16px] mr-[8px] text-text-muted\" />\n              Filtros\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-[24px]\">\n            {filteredShipments.map(shp => {\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <div \n                  key={shp.id} \n                  onClick={() => setSelectedShipment(shp)}\n                  className=\"bg-white border border-card-border rounded-[12px] cursor-pointer hover:border-brand/40 transition-all group flex flex-col shadow-sm\"\n                >\n                  <div className=\"p-[20px] pb-[16px]\">\n                    <div className=\"flex justify-between items-start mb-[12px]\">\n                      <span className=\"font-medium text-text-primary flex items-center text-[14px]\">\n                        <Anchor className=\"w-[14px] h-[14px] mr-[8px] text-text-muted group-hover:text-brand transition-colors stroke-[1.5px]\"/>\n                        {shp.id}\n                      </span>\n                      <span className=\"text-[11px] font-medium px-[8px] py-[2px] bg-canvas border border-card-border text-text-secondary rounded-[4px] flex items-center\">\n                        {getTransportIcon(shp.type)} {shp.type}\n                      </span>\n                    </div>\n                    <div className=\"text-[14px] font-medium text-text-primary mb-[16px] truncate\">{client}</div>\n                    \n                    <div className=\"flex items-center justify-between text-[13px] bg-canvas rounded-[6px] p-[10px] border border-divider\">\n                       <span className=\"text-text-secondary truncate max-w-[40%]\">{shp.origin.split(\',\')[0]}</span>\n                       <ArrowRight className=\"w-[14px] h-[14px] text-text-muted shrink-0 mx-[8px]\" />\n                       <span className=\"text-text-secondary truncate max-w-[40%] text-right\">{shp.destination.split(\',\')[0]}</span>\n                    </div>\n                  </div>\n                  \n                  <div className=\"px-[20px] pb-[20px] flex-1 flex flex-col justify-end\">\n                    <div className=\"mb-[12px]\">\n                      <div className=\"flex justify-between text-[11px] mb-[6px]\">\n                         <span className=\"font-medium text-text-secondary\">{steps[shp.timelineStep]}</span>\n                         <span className=\"text-text-muted tabular-nums\">ETA {shp.eta}</span>\n                      </div>\n                      <div className=\"h-[4px] bg-canvas rounded-full overflow-hidden flex\">\n                        {steps.map((_, idx) => (\n                          <div \n                            key={idx}\n                            className={`h-full flex-1 border-r border-white last:border-r-0 ${idx <= shp.timelineStep ? \'bg-brand\' : \'bg-divider\'}`}\n                          />\n                        ))}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-[24px]\">\n          {/* Header Detail */}\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-[8px] text-[13px] text-text-secondary\">\n              <button onClick={() => setSelectedShipment(null)} className=\"hover:text-text-primary transition-colors\">Embarques</button>\n              <ChevronRight className=\"w-[14px] h-[14px] text-text-muted\" />\n              <span className=\"text-text-primary font-medium\">{selectedShipment.id}</span>\n            </div>\n          </div>\n          \n          <div className=\"bg-white rounded-[12px] border border-card-border shadow-sm flex flex-col md:flex-row overflow-hidden\">\n             <div className=\"flex-1 flex flex-col border-r border-divider\">\n                <div className=\"p-[32px] border-b border-divider\">\n                   <div className=\"flex justify-between items-start mb-[32px]\">\n                      <div>\n                         <div className=\"flex items-center space-x-[12px] mb-[8px]\">\n                           <h2 className=\"text-[24px] font-semibold text-text-primary tracking-tight\">{selectedShipment.id}</h2>\n                           {getStatusBadge(selectedShipment.status)}\n                         </div>\n                         <p className=\"text-[14px] text-text-secondary flex items-center\">\n                            {initialClients.find(c => c.id === selectedShipment.clientId)?.name} \n                            <span className=\"mx-[8px] text-divider\">\342\200\242</span> \n                            {selectedShipment.type}\n                         </p>\n                      </div>\n                   </div>\n\n                   {/* Magaya Style Tracking Timeline */}\n                   <div className=\"relative pt-[20px]\">\n                      <div className=\"absolute top-[34px] left-[10%] right-[10%] h-[2px] bg-divider rounded-full\"></div>\n                      <div \n                         className=\"absolute top-[34px] left-[10%] h-[2px] bg-brand rounded-full transition-all duration-500\"\n                         style={{ width: `${(selectedShipment.timelineStep / (steps.length - 1)) * 80}%` }}\n                      ></div>\n                      \n                      <div className=\"flex justify-between relative z-10\">\n                         {steps.map((step, idx) => {\n                            const isCompleted = idx <= selectedShipment.timelineStep;\n                            const isCurrent = idx === selectedShipment.timelineStep;\n                            return (\n                              <div key={idx} className=\"flex flex-col items-center w-[20%]\">\n                                 <div className={`w-[30px] h-[30px] rounded-full flex items-center justify-center mb-[12px] border-[2px] ${isCurrent ? \'border-brand bg-white\' : isCompleted ? \'border-brand bg-brand text-white\' : \'border-divider bg-canvas text-text-muted\'}`}>\n                                    {isCompleted && !isCurrent ? <Check className=\"w-[14px] h-[14px]\" /> : <Circle className={`w-[8px] h-[8px] fill-current ${isCurrent ? \'text-brand\' : \'text-transparent\'}`} />}\n                                 </div>\n                                 <span className={`text-[12px] font-medium text-center ${isCompleted ? \'text-text-primary\' : \'text-text-muted\'}`}>{step}</span>\n                                 {isCompleted && <span className=\"text-[11px] text-text-muted mt-[4px] tabular-nums\">Oct {15 + idx}</span>}\n                              </div>\n                            );\n                         })}\n                      </div>\n                   </div>\n                </div>\n\n                <div className=\"px-[32px] border-b border-divider bg-canvas\">\n                  <nav className=\"-mb-px flex space-x-[24px]\">\n                    {detailTabs.map((tab) => (\n                      <button\n                        key={tab}\n                        onClick={() => setActiveTab(tab)}\n                        className={`py-[16px] px-[4px] text-[13px] font-medium transition-colors border-b-[2px] ${\n                          activeTab === tab\n                            ? \'border-brand text-text-primary\'\n                            : \'border-transparent text-text-muted hover:text-text-secondary hover:border-text-muted\'\n                        }`}\n                      >\n                        {tab}\n                      </button>\n                    ))}\n                  </nav>\n                </div>\n\n                <div className=\"p-[32px] flex-1 bg-canvas\">\n                   {activeTab === \'Resumen\' ? (\n                     <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[24px]\">\n                        <div className=\"bg-white border border-card-border rounded-[8px] p-[20px] shadow-sm\">\n                           <h4 className=\"text-[13px] font-semibold text-text-primary mb-[16px] flex items-center\">\n                             <Package className=\"w-[16px] h-[16px] mr-[8px] text-text-muted\" /> Detalles de Carga\n                           </h4>\n                           <div className=\"space-y-[12px] text-[13px]\">\n                              <div className=\"flex justify-between\">\n                                 <span className=\"text-text-secondary\">Contenedor / AWB</span>\n                                 <span className=\"text-text-primary font-medium font-mono\">{selectedShipment.type === \'Mar\303\255timo\' ? \'MSKU1234567\' : \'125-89347583\'}</span>\n                              </div>\n                              <div className=\"flex justify-between\">\n                                 <span className=\"text-text-secondary\">Piezas</span>\n                                 <span className=\"text-text-primary font-medium tabular-nums\">24 Pallets</span>\n                              </div>\n                              <div className=\"flex justify-between\">\n                                 <span className=\"text-text-secondary\">Peso bruto</span>\n                                 <span className=\"text-text-primary font-medium tabular-nums\">12,500 kg</span>\n                              </div>\n                              <div className=\"flex justify-between\">\n                                 <span className=\"text-text-secondary\">Volumen</span>\n                                 <span className=\"text-text-primary font-medium tabular-nums\">32.4 CBM</span>\n                              </div>\n                           </div>\n                        </div>\n\n                        <div className=\"bg-white border border-card-border rounded-[8px] p-[20px] shadow-sm\">\n                           <h4 className=\"text-[13px] font-semibold text-text-primary mb-[16px] flex items-center\">\n                             <FileText className=\"w-[16px] h-[16px] mr-[8px] text-text-muted\" /> Documentos Recientes\n                           </h4>\n                           <div className=\"space-y-[12px]\">\n                              {selectedShipment.documents.slice(0, 3).map((doc, i) => (\n                                <div key={i} className=\"flex justify-between items-center text-[13px] py-[6px] border-b border-divider last:border-0 last:pb-0\">\n                                   <span className=\"text-text-secondary flex items-center\">\n                                      <File className=\"w-[14px] h-[14px] mr-[8px] text-text-muted\" /> {doc.name}\n                                   </span>\n                                   {doc.status === \'ok\' ? (\n                                     <a href=\"#\" className=\"text-brand hover:underline font-medium\">Ver</a>\n                                   ) : (\n                                     <span className=\"text-text-muted flex items-center\"><ChevronDown className=\"w-[14px] h-[14px] mr-[4px]\" /> Pendiente</span>\n                                   )}\n                                </div>\n                              ))}\n                           </div>\n                        </div>\n                     </div>\n                   ) : (\n                     <div className=\"flex items-center justify-center p-[40px] text-text-muted text-[14px] border border-dashed border-card-border rounded-[8px] bg-canvas h-full min-h-[200px]\">\n                        Contenido de {activeTab}\n                     </div>\n                   )}\n                </div>\n             </div>\n\n             <div className=\"w-full md:w-[320px] bg-white shrink-0\">\n                <div className=\"p-[24px] border-b border-divider\">\n                   <h3 className=\"text-[14px] font-semibold text-text-primary mb-[20px] flex items-center\">\n                     <MapPin className=\"w-[16px] h-[16px] mr-[8px] text-text-muted\" /> Ruta Esquema\n                   </h3>\n                   <div className=\"relative pl-[16px] border-l-[2px] border-divider space-y-[24px]\">\n                      <div className=\"relative\">\n                         <div className=\"absolute -left-[21px] top-[2px] w-[10px] h-[10px] rounded-full bg-white border-[2px] border-brand shadow-[0_0_0_4px_white]\"></div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[2px]\">Origen</p>\n                         <p className=\"text-[13px] font-medium text-text-primary mb-[4px]\">{selectedShipment.origin}</p>\n                         <p className=\"text-[12px] text-text-secondary tabular-nums\">Cut-off: 2023-10-18</p>\n                      </div>\n                      <div className=\"relative\">\n                         <div className=\"absolute -left-[21px] top-[2px] w-[10px] h-[10px] rounded-full bg-white border-[2px] border-card-border shadow-[0_0_0_4px_white]\"></div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[2px]\">Destino</p>\n                         <p className=\"text-[13px] font-medium text-text-primary mb-[4px]\">{selectedShipment.destination}</p>\n                         <p className=\"text-[12px] text-text-secondary tabular-nums\">ETA: {selectedShipment.eta}</p>\n                      </div>\n                   </div>\n                </div>\n\n                <div className=\"p-[24px]\">\n                   <h3 className=\"text-[14px] font-semibold text-text-primary mb-[20px]\">Entidades involucradas</h3>\n                   <div className=\"space-y-[16px]\">\n                      <div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[4px]\">Shipper</p>\n                         <p className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                           <Building2 className=\"w-[14px] h-[14px] mr-[8px] text-text-muted\" />\n                           Shanghai Textiles Ltd.\n                         </p>\n                      </div>\n                      <div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[4px]\">Consignee</p>\n                         <p className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                           <Building2 className=\"w-[14px] h-[14px] mr-[8px] text-text-muted\" />\n                           {initialClients.find(c => c.id === selectedShipment.clientId)?.name}\n                         </p>\n                      </div>\n                      <div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[4px]\">Carrier</p>\n                         <p className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                           {getTransportIcon(selectedShipment.type)}\n                           {selectedShipment.carrier}\n                         </p>\n                      </div>\n                      <div>\n                         <p className=\"text-[11px] font-medium text-text-muted uppercase tracking-[0.05em] mb-[4px]\">Agente Aduanal</p>\n                         <p className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                           <User className=\"w-[14px] h-[14px] mr-[8px] text-text-muted\" />\n                           Aduanas y Maniobras S.C.\n                         </p>\n                      </div>\n                   </div>\n                </div>\n             </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
