    instruction: "Update the Sidebar to match the new Linear/Stripe style guidelines."
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { Home, FileText, Package, Users, BarChart2, Zap } from \'lucide-react\';\n\ninterface SidebarProps {\n  currentView: string;\n  onChangeView: (view: string) => void;\n}\n\nexport default function Sidebar({ currentView, onChangeView }: SidebarProps) {\n  const menuItems = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: <Home className=\"w-5 h-5 mr-3\" /> },\n    { id: \'quotes\', label: \'Cotizaciones\', icon: <FileText className=\"w-5 h-5 mr-3\" /> },\n    { id: \'shipments\', label: \'Embarques\', icon: <Package className=\"w-5 h-5 mr-3\" /> },\n    { id: \'clients\', label: \'Clientes\', icon: <Users className=\"w-5 h-5 mr-3\" /> },\n    { id: \'reports\', label: \'Reportes\', icon: <BarChart2 className=\"w-5 h-5 mr-3\" /> },\n  ];\n\n  return (\n    <>\n      <div className=\"hidden md:flex flex-col w-[220px] bg-navy min-h-screen text-white shrink-0 fixed\">\n        <div className=\"pt-[30px] pb-[30px] px-[20px] flex items-center justify-center border-b border-white/10 shrink-0\">\n          <img \n            src=\"https://firebasestorage.googleapis.com/v0/b/digsol-academy.firebasestorage.app/o/LOGOTIPO%20(1).png?alt=media&token=702db209-5869-4471-acb6-ac7740e5453b\"\n            alt=\"Vermur Logo\"\n            className=\"w-32 mb-1\"\n          />\n          <div className=\"text-xs tracking-wider text-gray-500 font-bold ml-1\">VermurOps\342\204\242</div>\n        </div>\n        \n        <nav className=\"flex-1 mt-4\">\n          <ul className=\"flex flex-col\">\n            {menuItems.map(item => (\n              <li key={item.id}>\n                <button\n                  onClick={() => onChangeView(item.id)}\n                  className={`w-full flex items-center px-[20px] py-[14px] text-[14px] transition-colors ${\n                    currentView === item.id \n                      ? \'bg-coral text-white font-semibold\' \n                      : \'text-white/70 hover:bg-white/5 hover:text-white\'\n                  }`}\n                >\n                  {item.icon}\n                  {item.label}\n                </button>\n              </li>\n            ))}\n          </ul>\n        </nav>\n        \n        <div className=\"p-5 text-[11px] opacity-50 text-white\">\n           VermurOps v2.4\n        </div>\n      </div>\n\n      <div className=\"md:hidden fixed bottom-0 left-0 right-0 bg-navy border-t border-gray-800 z-50\">\n        <nav className=\"flex justify-around\">\n          {menuItems.map(item => (\n            <button\n              key={item.id}\n              onClick={() => onChangeView(item.id)}\n              className={`flex flex-col items-center py-3 px-2 ${\n                currentView === item.id ? \'text-coral\' : \'text-gray-400\'\n              }`}\n            >\n              {item.icon}\n              <span className=\"text-[10px] mt-1 font-medium\">{item.label}</span>\n            </button>\n          ))}\n        </nav>\n      </div>\n    </>\n  );\n}"
        replacement_content: "import React from \'react\';\nimport { Home, FileText, Package, Users, BarChart2, Check } from \'lucide-react\';\n\ninterface SidebarProps {\n  currentView: string;\n  onChangeView: (view: string) => void;\n}\n\nexport default function Sidebar({ currentView, onChangeView }: SidebarProps) {\n  const menuItems = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: <Home className=\"w-[18px] h-[18px] mr-3 stroke-[1.5px]\" /> },\n    { id: \'quotes\', label: \'Cotizaciones\', icon: <FileText className=\"w-[18px] h-[18px] mr-3 stroke-[1.5px]\" /> },\n    { id: \'shipments\', label: \'Embarques\', icon: <Package className=\"w-[18px] h-[18px] mr-3 stroke-[1.5px]\" /> },\n    { id: \'clients\', label: \'Clientes\', icon: <Users className=\"w-[18px] h-[18px] mr-3 stroke-[1.5px]\" /> },\n    { id: \'reports\', label: \'Reportes\', icon: <BarChart2 className=\"w-[18px] h-[18px] mr-3 stroke-[1.5px]\" /> },\n  ];\n\n  return (\n    <>\n      <div className=\"hidden md:flex flex-col w-[240px] bg-surface-dark border-r border-surface-border min-h-screen text-text-inverse shrink-0 fixed z-20\">\n        <div className=\"h-[60px] px-[24px] flex items-center border-b border-surface-border shrink-0\">\n          <div className=\"flex items-center text-[18px] font-semibold tracking-tight\">\n             <span className=\"text-brand mr-[2px] flex items-center\">\n               <Check className=\"w-[22px] h-[22px] stroke-[3px]\" />\n             </span>\n             vermur<span className=\"text-text-inverse-muted font-normal ml-1 text-[13px]\">Ops</span>\n          </div>\n        </div>\n        \n        <nav className=\"flex-1 mt-6 px-[12px]\">\n          <div className=\"text-[11px] font-semibold text-text-inverse-muted uppercase tracking-[0.05em] mb-3 px-[12px]\">Plataforma</div>\n          <ul className=\"flex flex-col space-y-[2px]\">\n            {menuItems.map(item => (\n              <li key={item.id}>\n                <button\n                  onClick={() => onChangeView(item.id)}\n                  className={`w-full flex items-center px-[12px] py-[8px] text-[14px] rounded-md transition-colors ${\n                    currentView === item.id \n                      ? \'bg-surface-elevated text-brand font-medium shadow-sm\' \n                      : \'text-text-inverse-muted hover:bg-surface-elevated/50 hover:text-text-inverse\'\n                  }`}\n                >\n                  {item.icon}\n                  {item.label}\n                </button>\n              </li>\n            ))}\n          </ul>\n        </nav>\n        \n        <div className=\"p-[24px] text-[12px] text-text-inverse-muted\">\n           VermurOps v2.4\n        </div>\n      </div>\n\n      <div className=\"md:hidden fixed bottom-0 left-0 right-0 bg-surface-dark border-t border-surface-border z-50\">\n        <nav className=\"flex justify-around\">\n          {menuItems.map(item => (\n            <button\n              key={item.id}\n              onClick={() => onChangeView(item.id)}\n              className={`flex flex-col items-center py-3 px-2 ${\n                currentView === item.id ? \'text-brand\' : \'text-text-inverse-muted\'\n              }`}\n            >\n              <div className=\"mb-1\">{item.icon}</div>\n              <span className=\"text-[10px] font-medium\">{item.label}</span>\n            </button>\n          ))}\n        </nav>\n      </div>\n    </>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
