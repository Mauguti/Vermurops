    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { initialShipments, initialQuotes, initialClients } from \'../data\';\nimport { Package, FileText, Users, DollarSign, AlertCircle } from \'lucide-react\';\n\nexport default function Dashboard() {\n  const activeShipments = initialShipments.filter(s => s.status !== \'Entregado\').length;\n  const pendingQuotes = initialQuotes.filter(q => q.status === \'Enviada\').length;\n  const activeClients = initialClients.length;\n  \n  // Calculate a fake monthly revenue based on quotes\n  const monthlyRevenue = initialQuotes.filter(q => q.status === \'Aceptada\').reduce((acc, q) => acc + q.total, 0);\n\n  const getStatusColor = (status: string) => {\n    switch(status) {\n      case \'Entregado\': return \'bg-success/10 text-success\';\n      case \'En tr\303\241nsito\': return \'bg-success/10 text-success\';\n      case \'En aduana\': return \'bg-warning/10 text-warning\';\n      default: return \'bg-coral text-white\';\n    }\n  };\n\n  const pendingDocs = initialShipments.filter(s => s.documents.some(d => d.status === \'pending\'));\n\n  return (\n    <div className=\"space-y-0\">\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] mb-[25px]\">\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Embarques Activos</div>\n          <div className=\"text-[24px] font-bold\">{activeShipments}</div>\n        </div>\n        \n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Cotizaciones pdt.</div>\n          <div className=\"text-[24px] font-bold\">{pendingQuotes}</div>\n        </div>\n\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Clientes Activos</div>\n          <div className=\"text-[24px] font-bold\">{activeClients}</div>\n        </div>\n\n        <div className=\"bg-navy-med p-[20px] rounded text-white shadow-sm flex flex-col justify-center\">\n          <div className=\"text-[12px] opacity-70 uppercase tracking-[1px] mb-2\">Ingresos Mes (USD)</div>\n          <div className=\"text-[24px] font-bold\">${monthlyRevenue.toLocaleString()}</div>\n        </div>\n      </div>\n\n      {pendingDocs.length > 0 && (\n        <div className=\"bg-white border-l-4 border-coral py-[15px] px-[20px] shadow-sm mb-[25px] flex items-center justify-between\">\n          <div className=\"flex items-center text-[14px]\">\n            <strong className=\"text-coral mr-2 uppercase\">ALERTA OPERATIVA:</strong>\n            <span className=\"text-navy\">{pendingDocs.length} embarques requieren documentaci\303\263n.</span>\n          </div>\n          <button className=\"bg-coral text-white px-[16px] py-[8px] rounded text-[13px] font-semibold\">\n            Revisar\n          </button>\n        </div>\n      )}\n\n      <div className=\"bg-white rounded shadow-sm overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full border-collapse\">\n            <thead>\n              <tr>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\"># Embarque</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Cliente</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Origen / Destino</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Estatus</th>\n                <th className=\"bg-light text-left px-[20px] py-[12px] text-[11px] uppercase text-gray-500 border-b border-gray-200\">Fecha Est.</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-gray-100\">\n              {initialShipments.map(shp => {\n                const client = initialClients.find(c => c.id === shp.clientId)?.name;\n                return (\n                  <tr key={shp.id}>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{shp.id}</td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{client}</td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">\n                      {shp.origin.split(\',\')[0]} \342\206\222 {shp.destination.split(\',\')[0]}\n                    </td>\n                    <td className=\"px-[20px] py-[14px] border-b border-gray-100\">\n                      <span className={`px-[10px] py-[4px] rounded-[20px] text-[11px] font-semibold uppercase ${getStatusColor(shp.status)}`}>\n                        {shp.status}\n                      </span>\n                    </td>\n                    <td className=\"px-[20px] py-[14px] text-[13px] text-navy border-b border-gray-100\">{shp.eta}</td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React from \'react\';\nimport { initialShipments, initialQuotes, initialClients } from \'../data\';\nimport { Package, FileText, Users, DollarSign, AlertCircle, ArrowUpRight, ArrowDownRight } from \'lucide-react\';\n\nexport default function Dashboard() {\n  const activeShipments = initialShipments.filter(s => s.status !== \'Entregado\').length;\n  const pendingQuotes = initialQuotes.filter(q => q.status === \'Enviada\').length;\n  const activeClients = initialClients.length;\n  \n  // Calculate a fake monthly revenue based on quotes\n  const monthlyRevenue = initialQuotes.filter(q => q.status === \'Aceptada\').reduce((acc, q) => acc + q.total, 0);\n\n  const getStatusColor = (status: string) => {\n    switch(status) {\n      case \'Entregado\': return \'bg-success-bg text-success-text\';\n      case \'En tr\303\241nsito\': return \'bg-info-bg text-info-text\';\n      case \'En aduana\': return \'bg-warning-bg text-warning-text\';\n      default: return \'bg-neutral-bg text-neutral-text\';\n    }\n  };\n\n  const pendingDocs = initialShipments.filter(s => s.documents.some(d => d.status === \'pending\'));\n\n  return (\n    <div className=\"space-y-[24px]\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] mb-[25px]\">\n        {/* KPI Cards */}\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase tracking-[0.05em] font-semibold text-text-muted\">Embarques Activos</span>\n            <Package className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-medium text-text-primary tabular-nums\">{activeShipments}</div>\n          <div className=\"flex items-center text-[12px] font-medium text-success-text mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>12% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase tracking-[0.05em] font-semibold text-text-muted\">Cotizaciones (Mes)</span>\n            <FileText className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-medium text-text-primary tabular-nums\">{pendingQuotes}</div>\n          <div className=\"flex items-center text-[12px] font-medium text-success-text mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>4% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase tracking-[0.05em] font-semibold text-text-muted\">Clientes Activos</span>\n            <Users className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-medium text-text-primary tabular-nums\">{activeClients}</div>\n          <div className=\"flex items-center text-[12px] font-medium text-danger-text mt-1\">\n            <ArrowDownRight className=\"w-3 h-3 mr-1\" />\n            <span>-1.5% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase tracking-[0.05em] font-semibold text-text-muted\">Ingresos Mes (USD)</span>\n            <DollarSign className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-medium text-text-primary tabular-nums\">${monthlyRevenue.toLocaleString()}</div>\n          <div className=\"flex items-center text-[12px] font-medium text-success-text mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>8% m/m</span>\n          </div>\n        </div>\n      </div>\n\n      {pendingDocs.length > 0 && (\n        <div className=\"bg-danger-bg border border-danger-bg py-[16px] px-[24px] rounded-[12px] flex items-center justify-between\">\n          <div className=\"flex items-center text-[14px]\">\n            <strong className=\"text-danger-text mr-2 uppercase text-[12px] tracking-wide\">Alerta Operativa:</strong>\n            <span className=\"text-danger-text\">{pendingDocs.length} embarques requieren documentaci\303\263n.</span>\n          </div>\n          <button className=\"bg-white border border-card-border text-text-primary px-[16px] py-[8px] rounded-[8px] text-[13px] font-medium hover:bg-neutral-bg transition-colors shadow-sm\">\n            Revisar\n          </button>\n        </div>\n      )}\n\n      <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm overflow-hidden\">\n        <div className=\"px-[24px] py-[20px] border-b border-divider bg-white\">\n           <h3 className=\"text-[15px] font-semibold text-text-primary\">Supervisi\303\263n de Embarques</h3>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full border-collapse\">\n            <thead>\n              <tr>\n                <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase text-text-muted tracking-[0.05em] font-medium border-b border-divider\"># Embarque</th>\n                <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase text-text-muted tracking-[0.05em] font-medium border-b border-divider\">Cliente</th>\n                <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase text-text-muted tracking-[0.05em] font-medium border-b border-divider\">Origen / Destino</th>\n                <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase text-text-muted tracking-[0.05em] font-medium border-b border-divider\">Estatus</th>\n                <th className=\"bg-canvas text-left px-[24px] py-[14px] text-[11px] uppercase text-text-muted tracking-[0.05em] font-medium border-b border-divider\">Fecha Est.</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-divider\">\n              {initialShipments.map(shp => {\n                const client = initialClients.find(c => c.id === shp.clientId)?.name;\n                return (\n                  <tr key={shp.id} className=\"hover:bg-neutral-bg transition-colors\">\n                    <td className=\"px-[24px] py-[16px] text-[13px] font-medium text-text-primary\">{shp.id}</td>\n                    <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary\">{client}</td>\n                    <td className=\"px-[24px] py-[16px] text-[13px] text-text-primary\">\n                      <span className=\"text-text-secondary\">{shp.origin.split(\',\')[0]}</span>\n                      <span className=\"mx-2 text-text-muted\">\342\206\222</span>\n                      <span className=\"text-text-secondary\">{shp.destination.split(\',\')[0]}</span>\n                    </td>\n                    <td className=\"px-[24px] py-[16px]\">\n                      <span className={`px-[12px] py-[4px] rounded-full text-[11px] font-medium ${getStatusColor(shp.status)}`}>\n                        {shp.status}\n                      </span>\n                    </td>\n                    <td className=\"px-[24px] py-[16px] text-[13px] text-text-secondary tabular-nums\">{shp.eta}</td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
