    replacement_chunks {
      target_content: "export default function App() {\n  const [isAuthenticated, setIsAuthenticated] = useState(false);\n  const [currentView, setCurrentView] = useState(\'dashboard\');\n\n  if (!isAuthenticated) {\n    return <Login onLogin={() => setIsAuthenticated(true)} />;\n  }\n\n  const renderContent = () => {\n    switch (currentView) {\n      case \'dashboard\': return <Dashboard />;\n      case \'quotes\': return <Quotes />;\n      case \'shipments\': return <Shipments />;\n      case \'clients\': return <Clients />;\n      case \'reports\': return (\n        <div className=\"flex flex-col items-center justify-center h-[60vh] text-gray-500\">\n          <h2 className=\"text-xl font-bold text-navy mb-2\">Reportes Anal\303\255ticos</h2>\n          <p>M\303\263dulo de BI en construcci\303\263n para VermurOps V2.</p>\n        </div>\n      );\n      default: return <Dashboard />;\n    }\n  };\n\n  return (\n    <div className=\"flex min-h-screen bg-light\">\n      <Sidebar currentView={currentView} onChangeView={setCurrentView} />\n      \n      <div className=\"flex-1 md:ml-[220px] pb-20 md:pb-0 flex flex-col h-screen overflow-hidden bg-light\">\n        \n        {/* Header */}\n        <header className=\"bg-navy border-l border-white/10 h-[60px] flex items-center justify-between px-[30px] shrink-0 z-10 relative text-white\">\n           <h1 className=\"text-[18px] font-semibold text-white hidden md:block\">\n             {currentView === \'dashboard\' ? \'Dashboard Principal\' : \n              currentView === \'quotes\' ? \'Cotizaciones\' :\n              currentView === \'shipments\' ? \'Embarques\' :\n              currentView === \'clients\' ? \'Clientes\' : \n              \'VermurOps\'}\n           </h1>\n           <div className=\"md:hidden\">\n              <img \n                src=\"https://firebasestorage.googleapis.com/v0/b/digsol-academy.firebasestorage.app/o/LOGOTIPO%20(1).png?alt=media&token=702db209-5869-4471-acb6-ac7740e5453b\"\n                alt=\"Vermur Logo\"\n                className=\"h-6 object-contain\"\n              />\n           </div>\n           \n           <div className=\"flex items-center space-x-5 text-[13px]\">\n             <span className=\"opacity-80\">Admin Vermur</span>\n             <button \n               onClick={() => setIsAuthenticated(false)}\n               className=\"text-white/70 hover:text-white transition-opacity\"\n             >\n               Cerrar Sesi\303\263n\n             </button>\n           </div>\n        </header>\n\n        {/* Dynamic Content Surface */}\n        <main className=\"flex-1 overflow-auto p-[25px]\">\n           <div>\n             {renderContent()}\n           </div>\n        </main>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "export default function App() {\n  const [isAuthenticated, setIsAuthenticated] = useState(false);\n  const [currentView, setCurrentView] = useState(\'dashboard\');\n\n  if (!isAuthenticated) {\n    return <Login onLogin={() => setIsAuthenticated(true)} />;\n  }\n\n  const renderContent = () => {\n    switch (currentView) {\n      case \'dashboard\': return <Dashboard />;\n      case \'quotes\': return <Quotes />;\n      case \'shipments\': return <Shipments />;\n      case \'clients\': return <Clients />;\n      case \'reports\': return (\n        <div className=\"flex flex-col items-center justify-center h-[60vh] text-text-muted\">\n          <h2 className=\"text-[20px] font-semibold text-text-primary mb-2\">Reportes Anal\303\255ticos</h2>\n          <p>M\303\263dulo de BI en construcci\303\263n para VermurOps V2.</p>\n        </div>\n      );\n      default: return <Dashboard />;\n    }\n  };\n\n  return (\n    <div className=\"flex min-h-screen bg-canvas font-sans\">\n      <Sidebar currentView={currentView} onChangeView={setCurrentView} />\n      \n      <div className=\"flex-1 md:ml-[240px] pb-20 md:pb-0 flex flex-col h-screen overflow-hidden\">\n        \n        {/* Header */}\n        <header className=\"bg-surface-dark border-b border-surface-border h-[60px] flex items-center justify-between px-[32px] shrink-0 z-10 sticky top-0 text-text-inverse\">\n           <h1 className=\"text-[18px] font-semibold tracking-tight hidden md:block\">\n             {currentView === \'dashboard\' ? \'Dashboard Principal\' : \n              currentView === \'quotes\' ? \'Cotizaciones\' :\n              currentView === \'shipments\' ? \'Embarques\' :\n              currentView === \'clients\' ? \'Clientes\' : \n              \'VermurOps\'}\n           </h1>\n           <div className=\"md:hidden flex items-center\">\n             <div className=\"text-[18px] font-semibold tracking-tight\">\n               <span className=\"text-brand mr-[2px]\">V</span>ermur\n             </div>\n           </div>\n           \n           <div className=\"flex items-center space-x-[20px] text-[13px]\">\n             <span className=\"text-text-inverse-muted font-medium\">Admin Vermur</span>\n             <button \n               onClick={() => setIsAuthenticated(false)}\n               className=\"text-text-inverse-muted hover:text-text-inverse transition-colors font-medium\"\n             >\n               Cerrar Sesi\303\263n\n             </button>\n           </div>\n        </header>\n\n        {/* Dynamic Content Surface */}\n        <main className=\"flex-1 overflow-y-auto p-[24px] md:p-[32px]\">\n           <div className=\"max-w-[1100px] mx-auto\">\n             {renderContent()}\n           </div>\n        </main>\n      </div>\n    </div>\n  );\n}"
    }
