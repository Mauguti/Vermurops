      replacement_content: "import React, { useState } from \'react\';\nimport { initialClients, Client } from \'../data\';\nimport { Search, Building2, Phone, Mail, Package, FileText, ChevronRight } from \'lucide-react\';\n\nexport default function Clients() {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedClient, setSelectedClient] = useState<Client | null>(null);\n\n  const filteredClients = initialClients.filter(c => \n    c.name.toLowerCase().includes(searchTerm.toLowerCase()) || \n    c.rfc.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-6\">\n      {!selectedClient ? (\n        <>\n          <div className=\"flex justify-between items-center\">\n            <h2 className=\"text-2xl font-bold text-navy\">Directorio de Clientes</h2>\n            <button className=\"bg-coral hover:bg-opacity-90 text-white px-4 py-2 rounded text-sm font-medium transition-colors\">\n              Nuevo Cliente\n            </button>\n          </div>\n\n          <div className=\"relative mb-6\">\n            <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" />\n            <input \n              type=\"text\" \n              placeholder=\"Buscar por raz\303\263n social, RFC...\" \n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-3 bg-white border border-gray-200 rounded shadow-sm focus:border-coral focus:outline-none text-sm transition-colors\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {filteredClients.map(client => (\n              <div \n                key={client.id}\n                className=\"bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden group\"\n              >\n                <div className=\"p-5 border-b border-gray-100 bg-gray-50 flex justify-between items-start\">\n                  <div>\n                    <h3 className=\"font-bold text-navy text-lg leading-tight group-hover:text-coral transition-colors\">{client.name}</h3>\n                    <p className=\"text-xs text-gray-500 mt-1 font-mono\">RFC: {client.rfc}</p>\n                  </div>\n                  <div className=\"bg-navy bg-opacity-10 p-2 rounded-full\">\n                    <Building2 className=\"w-5 h-5 text-navy\" />\n                  </div>\n                </div>\n                \n                <div className=\"p-5 space-y-3\">\n                  <div className=\"flex items-center text-sm text-gray-600\">\n                    <Mail className=\"w-4 h-4 mr-3 text-gray-400\" />\n                    <span className=\"truncate\">{client.email}</span>\n                  </div>\n                  <div className=\"flex items-center text-sm text-gray-600\">\n                    <Phone className=\"w-4 h-4 mr-3 text-gray-400\" />\n                    {client.phone}\n                  </div>\n                </div>\n                \n                <div className=\"grid grid-cols-2 divide-x divide-gray-100 border-t border-gray-100 bg-gray-50\">\n                  <div className=\"p-3 text-center\">\n                    <div className=\"text-xs text-gray-500 font-medium mb-1\">Embarques</div>\n                    <div className=\"font-bold text-navy flex items-center justify-center\">\n                      <Package className=\"w-4 h-4 mr-1 text-blue-600\" />\n                      {client.shipmentsCount}\n                    </div>\n                  </div>\n                  <div className=\"p-3 text-center\">\n                    <div className=\"text-xs text-gray-500 font-medium mb-1\">Cotizaciones</div>\n                    <div className=\"font-bold text-navy flex items-center justify-center\">\n                      <FileText className=\"w-4 h-4 mr-1 text-green-600\" />\n                      {client.quotesCount}\n                    </div>\n                  </div>\n                </div>\n\n                <div \n                  onClick={() => setSelectedClient(client)}\n                  className=\"bg-navy text-white text-center py-2 text-sm font-medium cursor-pointer hover:bg-panel transition-colors\"\n                >\n                  Ver Ficha Completa\n                </div>\n              </div>\n            ))}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-6\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-2 text-sm text-gray-600\">\n              <button onClick={() => setSelectedClient(null)} className=\"hover:text-coral transition-colors font-medium\">Clientes</button>\n              <ChevronRight className=\"w-4 h-4\" />\n              <span className=\"text-navy font-bold\">{selectedClient.name}</span>\n            </div>\n            <button className=\"bg-coral hover:bg-opacity-90 text-white px-4 py-2 rounded text-sm font-medium transition-colors\">\n              Nueva cotizaci\303\263n\n            </button>\n          </div>\n\n          <div className=\"bg-white rounded-lg border border-gray-200 shadow-sm p-6 md:p-8\">\n            <div className=\"flex flex-col md:flex-row gap-8 items-start\">\n              \n              <div className=\"w-full md:w-1/3 bg-gray-50 p-6 rounded-lg border border-gray-100\">\n                <div className=\"w-16 h-16 bg-navy text-white flex items-center justify-center rounded-full text-2xl font-bold mb-4\">\n                  {selectedClient.name.charAt(0)}\n                </div>\n                <h3 className=\"text-xl font-bold text-navy mb-1\">{selectedClient.name}</h3>\n                <p className=\"text-gray-500 font-mono text-sm mb-6\">RFC: {selectedClient.rfc}</p>\n                \n                <h4 className=\"font-semibold text-sm text-gray-700 uppercase tracking-wider mb-3\">Contacto Principal</h4>\n                <p className=\"font-medium text-navy text-sm mb-1\">{selectedClient.contact}</p>\n                <div className=\"flex items-center text-sm text-gray-600 mb-2\">\n                  <Mail className=\"w-4 h-4 mr-2\" />\n                  <span className=\"truncate\">{selectedClient.email}</span>\n                </div>\n                <div className=\"flex items-center text-sm text-gray-600\">\n                  <Phone className=\"w-4 h-4 mr-2\" />\n                  {selectedClient.phone}\n                </div>\n              </div>\n\n              <div className=\"w-full md:w-2/3 space-y-6\">\n                <div>\n                  <h4 className=\"font-bold text-navy border-b pb-2 mb-4\">Historial de Operaciones</h4>\n                  <div className=\"grid grid-cols-2 gap-4\">\n                    <div className=\"bg-white border border-gray-200 p-4 rounded flex items-center\">\n                       <div className=\"bg-blue-50 p-3 rounded-full mr-4\">\n                         <Package className=\"w-6 h-6 text-blue-600\" />\n                       </div>\n                       <div>\n                         <p className=\"text-gray-500 text-sm\">Embarques Hist\303\263ricos</p>\n                         <h3 className=\"text-2xl font-bold text-navy\">{selectedClient.shipmentsCount}</h3>\n                       </div>\n                    </div>\n                    <div className=\"bg-white border border-gray-200 p-4 rounded flex items-center\">\n                       <div className=\"bg-green-50 p-3 rounded-full mr-4\">\n                         <FileText className=\"w-6 h-6 text-green-600\" />\n                       </div>\n                       <div>\n                         <p className=\"text-gray-500 text-sm\">Cotizaciones Solicitadas</p>\n                         <h3 className=\"text-2xl font-bold text-navy\">{selectedClient.quotesCount}</h3>\n                       </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"bg-white border border-gray-200 rounded p-6 flex flex-col items-center justify-center py-12 text-center text-gray-500\">\n                  <Building2 className=\"w-12 h-12 mb-3 opacity-20\" />\n                  <p className=\"font-medium text-navy\">Integraci\303\263n CRM</p>\n                  <p className=\"text-sm mt-1 max-w-sm\">Los documentos y m\303\251tricas espec\303\255ficas se sincronizan desde el m\303\263dulo central de operaciones de Vermur.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
