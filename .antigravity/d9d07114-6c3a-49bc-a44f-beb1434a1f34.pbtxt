    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { initialQuotes, initialClients, TransportType, Incoterm } from \'../data\';\nimport { Plane, Ship, Truck, FileText, Check, X, Clock } from \'lucide-react\';\n\nexport default function Quotes() {\n  const [showForm, setShowForm] = useState(false);\n\n  const getStatusBadge = (status: string) => {\n    switch(status) {\n      case \'Enviada\': return <span className=\"flex items-center px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs font-medium\"><Clock className=\"w-3 h-3 mr-1\"/> Enviada</span>;\n      case \'Aceptada\': return <span className=\"flex items-center px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-medium\"><Check className=\"w-3 h-3 mr-1\"/> Aceptada</span>;\n      case \'Rechazada\': return <span className=\"flex items-center px-2 py-1 bg-gray-200 text-gray-800 rounded text-xs font-medium\"><X className=\"w-3 h-3 mr-1\"/> Rechazada</span>;\n      case \'Vencida\': return <span className=\"flex items-center px-2 py-1 bg-red-100 text-red-800 rounded text-xs font-medium\"><Clock className=\"w-3 h-3 mr-1\"/> Vencida</span>;\n      default: return null;\n    }\n  };\n\n  const getTransportIcon = (type: string) => {\n    switch(type) {\n      case \'A\303\251reo\': return <Plane className=\"w-4 h-4 mr-2\" />;\n      case \'Mar\303\255timo\': return <Ship className=\"w-4 h-4 mr-2\" />;\n      case \'Terrestre\': return <Truck className=\"w-4 h-4 mr-2\" />;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center\">\n        <h2 className=\"text-2xl font-bold text-navy\">M\303\263dulo de Cotizaciones</h2>\n        <button \n          onClick={() => setShowForm(!showForm)}\n          className=\"bg-coral hover:bg-opacity-90 text-white px-4 py-2 rounded text-sm font-medium transition-colors\"\n        >\n          {showForm ? \'Volver al listado\' : \'Nueva Cotizaci\303\263n\'}\n        </button>\n      </div>\n\n      {showForm ? (\n        <div className=\"bg-white p-6 rounded-lg shadow-sm border border-gray-100\">\n          <h3 className=\"font-bold text-navy mb-4 border-b pb-2\">Crear Nueva Cotizaci\303\263n</h3>\n          <form className=\"space-y-6\" onSubmit={(e) => { e.preventDefault(); alert(\'Cotizaci\303\263n generada correctamente.\'); setShowForm(false); }}>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-sm text-gray-700 mb-1\">Cliente</label>\n                <select className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\">\n                  <option value=\"\">Selecciona un cliente</option>\n                  {initialClients.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}\n                </select>\n              </div>\n              <div>\n                <label className=\"block text-sm text-gray-700 mb-1\">Tipo de Transporte</label>\n                <div className=\"flex space-x-2\">\n                   {[\'A\303\251reo\', \'Mar\303\255timo\', \'Terrestre\'].map((type) => (\n                     <label key={type} className=\"flex-1 border border-gray-200 rounded px-3 py-2 flex items-center justify-center cursor-pointer hover:bg-gray-50 focus-within:ring-1 focus-within:ring-coral\">\n                       <input type=\"radio\" name=\"transport\" value={type} className=\"sr-only\" />\n                       {getTransportIcon(type)}\n                       <span className=\"text-sm font-medium\">{type}</span>\n                     </label>\n                   ))}\n                </div>\n              </div>\n              <div>\n                <label className=\"block text-sm text-gray-700 mb-1\">Origen (Ciudad/Puerto)</label>\n                <input type=\"text\" className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\" placeholder=\"Ej. Shanghai\" />\n              </div>\n              <div>\n                <label className=\"block text-sm text-gray-700 mb-1\">Destino (Ciudad/Puerto)</label>\n                <input type=\"text\" className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\" placeholder=\"Ej. Manzanillo\" />\n              </div>\n              <div className=\"flex space-x-4\">\n                <div className=\"flex-1\">\n                  <label className=\"block text-sm text-gray-700 mb-1\">Peso (kg)</label>\n                  <input type=\"number\" className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\" />\n                </div>\n                <div className=\"flex-1\">\n                  <label className=\"block text-sm text-gray-700 mb-1\">Volumen (m\302\263)</label>\n                  <input type=\"number\" className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\" />\n                </div>\n              </div>\n              <div>\n                <label className=\"block text-sm text-gray-700 mb-1\">Incoterm</label>\n                <select className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none\">\n                  {[\'EXW\', \'FOB\', \'CIF\', \'DDP\', \'DAP\'].map(inc => <option key={inc} value={inc}>{inc}</option>)}\n                </select>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-sm text-gray-700 mb-2\">Servicios Adicionales</label>\n              <div className=\"flex space-x-6\">\n                <label className=\"flex items-center text-sm\"><input type=\"checkbox\" className=\"mr-2 accent-coral\" /> Seguro de mercanc\303\255a</label>\n                <label className=\"flex items-center text-sm\"><input type=\"checkbox\" className=\"mr-2 accent-coral\" /> Despacho aduanal</label>\n                <label className=\"flex items-center text-sm\"><input type=\"checkbox\" className=\"mr-2 accent-coral\" /> \303\232ltima milla</label>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-sm text-gray-700 mb-1\">Notas Especiales</label>\n              <textarea className=\"w-full border border-gray-300 rounded px-3 py-2 focus:border-coral focus:outline-none h-20\" placeholder=\"Requerimientos espec\303\255ficos...\"></textarea>\n            </div>\n\n            <div className=\"bg-gray-50 p-4 rounded border border-gray-200\">\n               <h4 className=\"font-bold text-sm text-navy mb-3\">Simulaci\303\263n de Tarifa</h4>\n               <div className=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n                  <div>\n                    <label className=\"block text-xs text-gray-500\">Proveedor</label>\n                    <input type=\"text\" className=\"w-full text-sm border border-gray-300 rounded px-2 py-1 mt-1\" placeholder=\"Ej. MSC\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs text-gray-500\">Tarifa Base ($)</label>\n                    <input type=\"number\" className=\"w-full text-sm border border-gray-300 rounded px-2 py-1 mt-1\" defaultValue=\"0\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs text-gray-500\">Tr\303\241nsito</label>\n                    <input type=\"text\" className=\"w-full text-sm border border-gray-300 rounded px-2 py-1 mt-1\" placeholder=\"Ej. 15 d\303\255as\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs text-gray-500\">Margen (%)</label>\n                    <input type=\"number\" className=\"w-full text-sm border border-gray-300 rounded px-2 py-1 mt-1\" defaultValue=\"15\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs text-gray-500 font-bold\">Total Cliente</label>\n                    <div className=\"text-xl font-bold text-navy mt-1\">$0.00</div>\n                  </div>\n               </div>\n            </div>\n\n            <div className=\"flex justify-end space-x-3 pt-4 border-t\">\n              <button \n                type=\"button\" \n                onClick={() => setShowForm(false)}\n                className=\"px-4 py-2 border border-navy text-navy rounded hover:bg-gray-50 text-sm font-medium transition-colors\"\n              >\n                Cancelar\n              </button>\n              <button \n                type=\"submit\" \n                className=\"flex items-center px-4 py-2 bg-coral text-white rounded hover:bg-opacity-90 text-sm font-medium transition-colors\"\n              >\n                <FileText className=\"w-4 h-4 mr-2\" />\n                Generar cotizaci\303\263n PDF\n              </button>\n            </div>\n          </form>\n        </div>\n      ) : (\n        <div className=\"bg-white shadow-sm rounded-lg border border-gray-100 overflow-hidden\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-sm whitespace-nowrap\">\n              <thead className=\"bg-gray-50 text-gray-500 border-b border-gray-100\">\n                <tr>\n                  <th className=\"px-6 py-3 font-medium\">Cotizaci\303\263n</th>\n                  <th className=\"px-6 py-3 font-medium\">Cliente</th>\n                  <th className=\"px-6 py-3 font-medium\">Detalles</th>\n                  <th className=\"px-6 py-3 font-medium\">Fecha</th>\n                  <th className=\"px-6 py-3 font-medium\">Valor</th>\n                  <th className=\"px-6 py-3 font-medium\">Estatus</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-100\">\n                {initialQuotes.map(quote => {\n                  const client = initialClients.find(c => c.id === quote.clientId)?.name;\n                  return (\n                    <tr key={quote.id} className=\"hover:bg-gray-50 transition-colors\">\n                      <td className=\"px-6 py-4 font-bold text-navy\">{quote.id}</td>\n                      <td className=\"px-6 py-4 text-gray-700 font-medium\">{client}</td>\n                      <td className=\"px-6 py-4 text-gray-600\">\n                        <div className=\"flex items-center\">\n                          {getTransportIcon(quote.type)}\n                          <span>{quote.origin} \342\206\222 {quote.destination}</span>\n                        </div>\n                        <div className=\"text-xs text-gray-400 mt-1\">Incoterm: {quote.incoterm}</div>\n                      </td>\n                      <td className=\"px-6 py-4 text-gray-600\">{quote.date}</td>\n                      <td className=\"px-6 py-4 font-medium text-navy\">${quote.total.toLocaleString()}</td>\n                      <td className=\"px-6 py-4\">\n                        {getStatusBadge(quote.status)}\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
