      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", \"Geist\", ui-sans-serif, system-ui, sans-serif;\n  \n  --color-brand: #E11D48;\n  --color-brand-hover: #BE123C;\n  \n  --color-surface-dark: #0A0A0C;\n  --color-surface-elevated: #141417;\n  --color-surface-border: #1F1F23;\n  \n  --color-canvas: #FAFAFB;\n  --color-card: #FFFFFF;\n  --color-card-border: #ECECEF;\n  --color-divider: #F1F1F3;\n  \n  --color-text-primary: #18181B;\n  --color-text-secondary: #52525B;\n  --color-text-muted: #A1A1AA;\n  \n  --color-text-inverse: #FAFAFA;\n  --color-text-inverse-muted: #A1A1AA;\n  \n  --color-success-bg: #F0FDF4;\n  --color-success-text: #15803D;\n  \n  --color-warning-bg: #FFFBEB;\n  --color-warning-text: #B45309;\n  \n  --color-info-bg: #EFF6FF;\n  --color-info-text: #1D4ED8;\n  \n  --color-danger-bg: #FEF2F2;\n  --color-danger-text: #B91C1C;\n  \n  --color-neutral-bg: #F4F4F5;\n  --color-neutral-text: #52525B;\n}\n\nbody {\n  background-color: var(--color-canvas);\n  color: var(--color-text-primary);\n  -webkit-font-smoothing: antialiased;\n}\n\n.login-texture {\n  background-image: radial-gradient(circle at 2px 2px, rgba(255, 255, 255, 0.03) 1px, transparent 0);\n  background-size: 24px 24px;\n}\n\n.tabular-data {\n  font-variant-numeric: tabular-nums;\n}"
