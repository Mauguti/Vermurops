    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { initialShipments, initialClients, Shipment } from \'../data\';\nimport { Search, Filter, Anchor, Package, CheckCircle2, ChevronRight, File } from \'lucide-react\';\n\nexport default function Shipments() {\n  const [selectedShipment, setSelectedShipment] = useState<Shipment | null>(null);\n\n  const steps = [\'Cotizado\', \'Confirmado\', \'En tr\303\241nsito\', \'En aduana\', \'Entregado\'];\n\n  return (\n    <div className=\"space-y-6\">\n      {!selectedShipment ? (\n        <>\n          <div className=\"flex justify-between items-center hidden\">\n            <h2 className=\"text-[18px] font-semibold text-navy\">M\303\263dulo de Embarques</h2>\n          </div>\n\n          <div className=\"flex space-x-3 bg-white p-[15px] rounded border border-gray-100 mb-[25px]\">\n            <div className=\"flex-1 relative\">\n              <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por cliente, origen, destino, ID...\" \n                className=\"w-full pl-[36px] outline-none text-[14px]\"\n              />\n            </div>\n            <button className=\"flex items-center px-[16px] py-[8px] bg-white border border-gray-200 rounded text-[13px] font-semibold text-navy hover:bg-gray-50 uppercase\">\n              <Filter className=\"w-4 h-4 mr-2\" />\n              Filtros\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]\">\n            {initialShipments.map(shp => {\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <div \n                  key={shp.id} \n                  onClick={() => setSelectedShipment(shp)}\n                  className=\"bg-white border border-gray-100 rounded cursor-pointer hover:border-gray-300 transition-colors group flex flex-col\"\n                >\n                  <div className=\"border-b border-gray-100 p-[20px] flex justify-between items-center\">\n                    <span className=\"font-bold text-navy flex items-center text-[15px]\">\n                      <Anchor className=\"w-4 h-4 mr-2 text-coral\"/>\n                      {shp.id}\n                    </span>\n                    <span className=\"text-[11px] font-bold px-[10px] py-[4px] bg-light text-navy rounded-[20px] uppercase\">\n                      {shp.type}\n                    </span>\n                  </div>\n                  <div className=\"p-[20px] space-y-[15px] flex-1\">\n                    <div>\n                      <div className=\"text-[11px] font-bold text-gray-400 uppercase mb-1\">Cliente</div>\n                      <div className=\"font-semibold text-navy text-[14px]\">{client}</div>\n                    </div>\n                    \n                    <div className=\"flex items-center pt-2\">\n                       <div className=\"flex-1\">\n                          <div className=\"font-semibold text-navy text-[14px] truncate\">{shp.origin.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-bold text-gray-400 uppercase\">Origen</div>\n                       </div>\n                       <div className=\"px-3 text-gray-300\">\342\206\222</div>\n                       <div className=\"flex-1 text-right\">\n                          <div className=\"font-semibold text-navy text-[14px] truncate\">{shp.destination.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-bold text-gray-400 uppercase\">Destino</div>\n                       </div>\n                    </div>\n\n                    <div className=\"pt-[15px] border-t border-gray-100 text-[13px] flex justify-between items-center\">\n                      <span className=\"text-navy font-semibold flex items-center\">\n                        <Package className=\"w-4 h-4 mr-2 text-coral\"/>\n                        {shp.status}\n                      </span>\n                      <span className=\"text-gray-500\">ETA: {shp.eta}</span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-6\">\n          <div className=\"flex items-center space-x-2 text-[13px] text-gray-500 mb-6\">\n            <button onClick={() => setSelectedShipment(null)} className=\"hover:text-coral transition-colors\">Embarques</button>\n            <ChevronRight className=\"w-4 h-4\" />\n            <span className=\"text-navy font-semibold\">{selectedShipment.id}</span>\n          </div>\n          \n          <div className=\"bg-white rounded border border-gray-100 shadow-sm p-[25px]\">\n            <div className=\"flex justify-between items-start mb-[30px]\">\n              <div>\n                <h3 className=\"text-[20px] font-semibold text-navy mb-1\">{selectedShipment.id}</h3>\n                <p className=\"text-gray-400 text-[14px]\">{initialClients.find(c => c.id === selectedShipment.clientId)?.name}</p>\n              </div>\n              <div className=\"text-right border border-gray-100 rounded p-[15px] bg-light\">\n                <div className=\"text-[11px] font-bold text-gray-400 uppercase mb-1\">Carrier</div>\n                <div className=\"font-semibold text-navy text-[15px]\">{selectedShipment.carrier}</div>\n                <div className=\"text-[11px] text-gray-400 mt-1 uppercase font-semibold\">Incoterm: {selectedShipment.incoterm}</div>\n              </div>\n            </div>\n\n            {/* Timeline visual */}\n            <div className=\"mb-10 w-full relative\">\n              <div className=\"overflow-hidden h-2 mb-4 text-xs flex rounded bg-gray-100\">\n                <div style={{ width: `${(selectedShipment.timelineStep / (steps.length - 1)) * 100}%` }} className=\"shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-coral\"></div>\n              </div>\n              <div className=\"flex justify-between text-xs font-medium text-gray-500 -mx-4 sm:mx-0\">\n                {steps.map((step, idx) => (\n                  <div key={idx} className={`flex flex-col items-center ${idx <= selectedShipment.timelineStep ? \'text-coral\' : \'\'} w-1/5 text-center`}>\n                     {idx <= selectedShipment.timelineStep ? <CheckCircle2 className=\"w-5 h-5 mb-1 text-coral\" /> : <div className=\"w-5 h-5 mb-1 rounded-full border-2 border-gray-300\" />}\n                     <span className=\"hidden sm:inline\">{step}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[30px]\">\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-navy border-b border-gray-100 pb-2 mb-4\">Documentaci\303\263n del Embarque</h4>\n                 <ul className=\"space-y-3\">\n                   {selectedShipment.documents.map((doc, idx) => (\n                     <li key={idx} className=\"flex items-center justify-between p-[12px] bg-light rounded border border-gray-100\">\n                       <span className=\"flex items-center text-[13px] font-medium text-navy\">\n                         <File className=\"w-4 h-4 mr-2 text-gray-400\" />\n                         {doc.name}\n                       </span>\n                       {doc.status === \'ok\' ? (\n                         <span className=\"text-[11px] font-semibold px-[10px] py-[4px] bg-success/10 text-success rounded uppercase\">Cargado</span>\n                       ) : (\n                         <button className=\"text-[11px] font-bold px-[12px] py-[6px] border border-coral text-coral rounded hover:bg-coral hover:text-white transition-colors uppercase\">\n                           Subir archivo\n                         </button>\n                       )}\n                     </li>\n                   ))}\n                 </ul>\n               </div>\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-navy border-b border-gray-100 pb-2 mb-4\">Notas Operativas</h4>\n                 <div className=\"bg-warning/10 border border-warning/20 p-[15px] rounded text-[13px] text-navy h-full\">\n                    {selectedShipment.notes}\n                 </div>\n               </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { initialShipments, initialClients, Shipment } from \'../data\';\nimport { Search, Filter, Anchor, Package, CheckCircle2, ChevronRight, File } from \'lucide-react\';\n\nexport default function Shipments() {\n  const [selectedShipment, setSelectedShipment] = useState<Shipment | null>(null);\n\n  const steps = [\'Cotizado\', \'Confirmado\', \'En tr\303\241nsito\', \'En aduana\', \'Entregado\'];\n\n  return (\n    <div className=\"space-y-[24px]\">\n      {!selectedShipment ? (\n        <>\n          <div className=\"flex justify-between items-center hidden\">\n            <h2 className=\"text-[20px] font-semibold text-text-primary\">Embarques</h2>\n          </div>\n\n          <div className=\"flex space-x-[12px] bg-card p-[16px] rounded-[12px] border border-card-border shadow-sm mb-[24px]\">\n            <div className=\"flex-1 relative\">\n              <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por cliente, origen, destino, ID...\" \n                className=\"w-full pl-[36px] outline-none text-[14px] text-text-primary bg-transparent\"\n              />\n            </div>\n            <button className=\"flex items-center px-[16px] py-[8px] bg-card border border-card-border rounded-[8px] text-[13px] font-medium text-text-primary hover:bg-neutral-bg transition-colors\">\n              <Filter className=\"w-4 h-4 mr-2\" />\n              Filtros\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[24px]\">\n            {initialShipments.map(shp => {\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <div \n                  key={shp.id} \n                  onClick={() => setSelectedShipment(shp)}\n                  className=\"bg-card border border-card-border rounded-[12px] cursor-pointer hover:border-brand/30 hover:shadow-md transition-all group flex flex-col shadow-sm\"\n                >\n                  <div className=\"border-b border-divider p-[24px] flex justify-between items-center\">\n                    <span className=\"font-semibold text-text-primary flex items-center text-[15px]\">\n                      <Anchor className=\"w-4 h-4 mr-2 text-text-muted transition-colors group-hover:text-brand\"/>\n                      {shp.id}\n                    </span>\n                    <span className=\"text-[11px] tracking-[0.05em] font-medium px-[10px] py-[4px] bg-neutral-bg text-text-secondary rounded-full uppercase\">\n                      {shp.type}\n                    </span>\n                  </div>\n                  <div className=\"px-[24px] py-[20px] space-y-[16px] flex-1\">\n                    <div>\n                      <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mb-[4px]\">Cliente</div>\n                      <div className=\"font-medium text-text-primary text-[14px]\">{client}</div>\n                    </div>\n                    \n                    <div className=\"flex items-center pt-[4px]\">\n                       <div className=\"flex-1\">\n                          <div className=\"font-medium text-text-primary text-[14px] truncate\">{shp.origin.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mt-[2px]\">Origen</div>\n                       </div>\n                       <div className=\"px-3 text-text-muted\">\342\206\222</div>\n                       <div className=\"flex-1 text-right\">\n                          <div className=\"font-medium text-text-primary text-[14px] truncate\">{shp.destination.split(\',\')[0]}</div>\n                          <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mt-[2px]\">Destino</div>\n                       </div>\n                    </div>\n\n                    <div className=\"pt-[16px] border-t border-divider text-[13px] flex justify-between items-center\">\n                      <span className=\"text-text-primary font-medium flex items-center\">\n                        <Package className=\"w-4 h-4 mr-2 text-text-muted transition-colors group-hover:text-brand\"/>\n                        {shp.status}\n                      </span>\n                      <span className=\"text-text-secondary tabular-nums\">ETA: {shp.eta}</span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-[24px]\">\n          <div className=\"flex items-center space-x-2 text-[13px] text-text-secondary mb-[8px]\">\n            <button onClick={() => setSelectedShipment(null)} className=\"hover:text-text-primary transition-colors\">Embarques</button>\n            <ChevronRight className=\"w-4 h-4 text-text-muted\" />\n            <span className=\"text-text-primary font-medium\">{selectedShipment.id}</span>\n          </div>\n          \n          <div className=\"bg-card rounded-[12px] border border-card-border shadow-sm p-[32px]\">\n            <div className=\"flex justify-between items-start mb-[32px]\">\n              <div>\n                <h3 className=\"text-[24px] font-semibold text-text-primary mb-[4px]\">{selectedShipment.id}</h3>\n                <p className=\"text-text-secondary text-[14px]\">{initialClients.find(c => c.id === selectedShipment.clientId)?.name}</p>\n              </div>\n              <div className=\"text-right border border-card-border rounded-[8px] p-[16px] bg-canvas\">\n                <div className=\"text-[11px] font-semibold tracking-[0.05em] text-text-muted uppercase mb-1\">Carrier</div>\n                <div className=\"font-medium text-text-primary text-[15px] mb-[4px]\">{selectedShipment.carrier}</div>\n                <div className=\"text-[11px] tracking-[0.05em] text-text-muted uppercase font-medium\">Incoterm: {selectedShipment.incoterm}</div>\n              </div>\n            </div>\n\n            {/* Timeline visual */}\n            <div className=\"mb-[40px] w-full relative\">\n              <div className=\"overflow-hidden h-[4px] mb-[16px] text-xs flex rounded-full bg-divider\">\n                <div style={{ width: `${(selectedShipment.timelineStep / (steps.length - 1)) * 100}%` }} className=\"shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-brand transition-all duration-500\"></div>\n              </div>\n              <div className=\"flex justify-between text-[12px] font-medium text-text-muted -mx-4 sm:mx-0\">\n                {steps.map((step, idx) => (\n                  <div key={idx} className={`flex flex-col items-center ${idx <= selectedShipment.timelineStep ? \'text-text-primary\' : \'\'} w-1/5 text-center`}>\n                     {idx <= selectedShipment.timelineStep ? <CheckCircle2 className=\"w-[18px] h-[18px] mb-[8px] text-brand\" /> : <div className=\"w-[18px] h-[18px] mb-[8px] rounded-full border-2 border-divider\" />}\n                     <span className=\"hidden sm:inline\">{step}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[32px]\">\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-text-primary border-b border-divider pb-[8px] mb-[16px]\">Documentaci\303\263n</h4>\n                 <ul className=\"space-y-[12px]\">\n                   {selectedShipment.documents.map((doc, idx) => (\n                     <li key={idx} className=\"flex items-center justify-between p-[16px] bg-canvas rounded-[8px] border border-card-border\">\n                       <span className=\"flex items-center text-[13px] font-medium text-text-primary\">\n                         <File className=\"w-4 h-4 mr-3 text-text-muted\" />\n                         {doc.name}\n                       </span>\n                       {doc.status === \'ok\' ? (\n                         <span className=\"text-[11px] font-medium tracking-[0.05em] px-[10px] py-[4px] bg-success-bg text-success-text rounded-full uppercase\">Cargado</span>\n                       ) : (\n                         <button className=\"text-[11px] font-medium tracking-[0.05em] px-[12px] py-[6px] border border-brand text-brand rounded-[6px] hover:bg-brand hover:text-white transition-colors uppercase\">\n                           Subir\n                         </button>\n                       )}\n                     </li>\n                   ))}\n                 </ul>\n               </div>\n               <div>\n                 <h4 className=\"font-semibold text-[15px] text-text-primary border-b border-divider pb-[8px] mb-[16px]\">Notas Operativas</h4>\n                 <div className=\"bg-warning-bg border border-warning-bg p-[16px] rounded-[8px] text-[13px] text-warning-text h-[calc(100%-40px)]\">\n                    {selectedShipment.notes}\n                 </div>\n               </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
    }
