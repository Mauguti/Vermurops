      target_content: "import React from \'react\';\nimport { Package, TrendingUp, AlertCircle, Clock, FileText, ArrowUpRight, ArrowDownRight, Anchor, CheckCircle } from \'lucide-react\';\nimport { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from \'recharts\';\n\nconst chartData = [\n  { month: \'Ene\', value: 85 },\n  { month: \'Feb\', value: 92 },\n  { month: \'Mar\', value: 78 },\n  { month: \'Abr\', value: 110 },\n  { month: \'May\', value: 135 },\n  { month: \'Jun\', value: 125 },\n];\n\nexport default function Dashboard() {\n  return (\n    <div className=\"space-y-6\">\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* KPI Cards */}\n        <div className=\"bg-white p-5 rounded border border-gray-100 shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase font-bold text-gray-400\">Embarques Activos</span>\n            <Package className=\"w-4 h-4 text-coral\" />\n          </div>\n          <div className=\"text-[28px] font-bold text-navy\">124</div>\n          <div className=\"flex items-center text-[12px] font-semibold text-success mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>12% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-5 rounded border border-gray-100 shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase font-bold text-gray-400\">Cotizaciones (Mes)</span>\n            <FileText className=\"w-4 h-4 text-coral\" />\n          </div>\n          <div className=\"text-[28px] font-bold text-navy\">48</div>\n          <div className=\"flex items-center text-[12px] font-semibold text-success mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>4% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-5 rounded border border-gray-100 shadow-sm\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] uppercase font-bold text-gray-400\">Eficiencia ETA</span>\n            <CheckCircle className=\"w-4 h-4 text-coral\" />\n          </div>\n          <div className=\"text-[28px] font-bold text-navy\">94.2%</div>\n          <div className=\"flex items-center text-[12px] font-semibold text-coral mt-1\">\n            <ArrowDownRight className=\"w-3 h-3 mr-1\" />\n            <span>-1.5% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-5 rounded border border-gray-100 shadow-sm relative overflow-hidden group hover:border-coral transition-colors cursor-pointer\">\n          <div className=\"absolute inset-0 bg-coral opacity-0 group-hover:opacity-5 transition-opacity\"></div>\n          <div className=\"flex justify-between items-start mb-2 relative\">\n            <span className=\"text-[11px] uppercase font-bold text-coral\">Alertas Cr\303\255ticas</span>\n            <AlertCircle className=\"w-4 h-4 text-coral\" />\n          </div>\n          <div className=\"text-[28px] font-bold text-navy relative\">3</div>\n          <div className=\"flex items-center text-[12px] font-semibold text-gray-500 mt-1 relative\">\n            <span>Requieren atenci\303\263n inmediata</span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Chart */}\n        <div className=\"col-span-1 lg:col-span-2 bg-white border border-gray-100 shadow-sm rounded p-5\">\n          <h3 className=\"text-[15px] font-semibold text-navy mb-4\">Volumen de Embarques</h3>\n          <div className=\"h-[250px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData} margin={{ top: 10, right: 0, left: -20, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"colorPv\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#1A1A2E\" stopOpacity={0.8}/>\n                    <stop offset=\"95%\" stopColor=\"#1A1A2E\" stopOpacity={0}/>\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#f3f4f6\" />\n                <XAxis dataKey=\"month\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#9ca3af\' }} dy={10} />\n                <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#9ca3af\' }} />\n                <Tooltip \n                  contentStyle={{ backgroundColor: \'#1A1A2E\', borderColor: \'#1A1A2E\', borderRadius: \'4px\', color: \'#fff\' }}\n                  itemStyle={{ color: \'#fff\' }}\n                />\n                <Area type=\"monotone\" dataKey=\"value\" stroke=\"#1A1A2E\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorPv)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Priority List */}\n        <div className=\"bg-white border border-gray-100 shadow-sm rounded p-5\">\n          <h3 className=\"text-[15px] font-semibold text-navy mb-4\">Seguimiento Prioritario</h3>\n          <div className=\"space-y-4\">\n            <div className=\"flex items-start bg-red-50 p-3 rounded border border-red-100\">\n              <AlertCircle className=\"w-5 h-5 text-red-500 mr-3 shrink-0 mt-0.5\" />\n              <div>\n                <p className=\"text-[13px] font-bold text-red-800\">MZO-8902 Demora en puerto</p>\n                <p className=\"text-[12px] text-red-600 mt-1\">+48h en espera de maniobra</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start bg-yellow-50 p-3 rounded border border-yellow-100\">\n              <Clock className=\"w-5 h-5 text-yellow-600 mr-3 shrink-0 mt-0.5\" />\n              <div>\n                <p className=\"text-[13px] font-bold text-yellow-800\">SHA-4410 Pendiente despacho</p>\n                <p className=\"text-[12px] text-yellow-700 mt-1\">Revisi\303\263n aduanal requerida</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start bg-gray-50 p-3 rounded border border-gray-200\">\n              <Anchor className=\"w-5 h-5 text-blue-500 mr-3 shrink-0 mt-0.5\" />\n              <div>\n                <p className=\"text-[13px] font-bold text-navy\">NTX-2301 Arribo estimado</p>\n                <p className=\"text-[12px] text-gray-500 mt-1\">ETA actualizado a 24h</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React from \'react\';\nimport { Package, TrendingUp, AlertCircle, Clock, FileText, ArrowUpRight, ArrowDownRight, Anchor, CheckCircle } from \'lucide-react\';\nimport { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from \'recharts\';\n\nconst chartData = [\n  { month: \'Ene\', value: 85 },\n  { month: \'Feb\', value: 92 },\n  { month: \'Mar\', value: 78 },\n  { month: \'Abr\', value: 110 },\n  { month: \'May\', value: 135 },\n  { month: \'Jun\', value: 125 },\n];\n\nexport default function Dashboard() {\n  return (\n    <div className=\"space-y-[24px]\">\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px]\">\n        {/* KPI Cards */}\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[12px] uppercase tracking-wide font-semibold text-text-muted\">Embarques Activos</span>\n            <Package className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-semibold text-text-primary tabular-data\">124</div>\n          <div className=\"flex items-center text-[12px] font-medium text-success-text mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>12% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[12px] uppercase tracking-wide font-semibold text-text-muted\">Cotizaciones (Mes)</span>\n            <FileText className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-semibold text-text-primary tabular-data\">48</div>\n          <div className=\"flex items-center text-[12px] font-medium text-success-text mt-1\">\n            <ArrowUpRight className=\"w-3 h-3 mr-1\" />\n            <span>4% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[12px] uppercase tracking-wide font-semibold text-text-muted\">Eficiencia (ETA)</span>\n            <CheckCircle className=\"w-4 h-4 text-text-muted\" />\n          </div>\n          <div className=\"text-[28px] font-semibold text-text-primary tabular-data\">94.2%</div>\n          <div className=\"flex items-center text-[12px] font-medium text-danger-text mt-1\">\n            <ArrowDownRight className=\"w-3 h-3 mr-1\" />\n            <span>-1.5% m/m</span>\n          </div>\n        </div>\n\n        <div className=\"bg-card p-[20px] rounded-[12px] border border-card-border\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[12px] uppercase tracking-wide font-semibold text-text-muted\">Alertas Cr\303\255ticas</span>\n            <AlertCircle className=\"w-4 h-4 text-danger-text\" />\n          </div>\n          <div className=\"text-[28px] font-semibold text-text-primary tabular-data\">3</div>\n          <div className=\"flex items-center text-[12px] font-medium text-text-muted mt-1\">\n            <span>Requieren atenci\303\263n inmediata</span>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-[20px]\">\n        {/* Chart */}\n        <div className=\"col-span-1 lg:col-span-2 bg-card border border-card-border rounded-[12px] p-[24px]\">\n          <h3 className=\"text-[15px] font-semibold text-text-primary mb-[20px]\">Volumen de Embarques</h3>\n          <div className=\"h-[250px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData} margin={{ top: 10, right: 0, left: -20, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"colorValue\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#18181B\" stopOpacity={0.1}/>\n                    <stop offset=\"95%\" stopColor=\"#18181B\" stopOpacity={0}/>\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#F1F1F3\" />\n                <XAxis dataKey=\"month\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#A1A1AA\' }} dy={10} />\n                <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#A1A1AA\' }} />\n                <Tooltip \n                  contentStyle={{ backgroundColor: \'#141417\', borderColor: \'#1F1F23\', borderRadius: \'8px\', color: \'#FAFAFA\' }}\n                  itemStyle={{ color: \'#FAFAFA\' }}\n                />\n                <Area type=\"monotone\" dataKey=\"value\" stroke=\"#18181B\" strokeWidth={2} fillOpacity={1} fill=\"url(#colorValue)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Priority List */}\n        <div className=\"bg-card border border-card-border rounded-[12px] p-[24px]\">\n          <h3 className=\"text-[15px] font-semibold text-text-primary mb-[20px]\">Seguimiento Prioritario</h3>\n          <div className=\"space-y-[16px]\">\n            <div className=\"flex justify-between items-start border-b border-divider pb-[16px]\">\n              <div className=\"flex items-start\">\n                <AlertCircle className=\"w-4 h-4 text-danger-text mr-3 mt-0.5 shrink-0\" />\n                <div>\n                  <p className=\"text-[13px] font-semibold text-text-primary leading-tight\">MZO-8902</p>\n                  <p className=\"text-[12px] text-text-muted mt-0.5\">Demora en puerto (+48h)</p>\n                </div>\n              </div>\n              <span className=\"text-[11px] font-medium px-2 py-0.5 bg-danger-bg text-danger-text rounded-full\">Cr\303\255tico</span>\n            </div>\n\n            <div className=\"flex justify-between items-start border-b border-divider pb-[16px]\">\n              <div className=\"flex items-start\">\n                <Clock className=\"w-4 h-4 text-warning-text mr-3 mt-0.5 shrink-0\" />\n                <div>\n                  <p className=\"text-[13px] font-semibold text-text-primary leading-tight\">SHA-4410</p>\n                  <p className=\"text-[12px] text-text-muted mt-0.5\">Pendiente de despacho</p>\n                </div>\n              </div>\n              <span className=\"text-[11px] font-medium px-2 py-0.5 bg-warning-bg text-warning-text rounded-full\">Alerta</span>\n            </div>\n\n            <div className=\"flex justify-between items-start\">\n              <div className=\"flex items-start\">\n                <Anchor className=\"w-4 h-4 text-info-text mr-3 mt-0.5 shrink-0\" />\n                <div>\n                  <p className=\"text-[13px] font-semibold text-text-primary leading-tight\">NTX-2301</p>\n                  <p className=\"text-[12px] text-text-muted mt-0.5\">Arribo estimado en 24h</p>\n                </div>\n              </div>\n              <span className=\"text-[11px] font-medium px-2 py-0.5 bg-info-bg text-info-text rounded-full\">Info</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
    instruction: "Update Dashboard colors and layout to match new minimalist theme"
  }
