  file_change {
    absolute_path_uri: "file:///src/components/Shipments.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { initialShipments, initialClients, Shipment } from \'../data\';\nimport { Search, Filter, Anchor, Package, CheckCircle2, ChevronRight, File } from \'lucide-react\';\n\nexport default function Shipments() {\n  const [selectedShipment, setSelectedShipment] = useState<Shipment | null>(null);\n\n  const steps = [\'Cotizado\', \'Confirmado\', \'En tr\303\241nsito\', \'En aduana\', \'Entregado\'];\n\n  return (\n    <div className=\"space-y-6\">\n      {!selectedShipment ? (\n        <>\n          <div className=\"flex justify-between items-center\">\n            <h2 className=\"text-2xl font-bold text-navy\">M\303\263dulo de Embarques</h2>\n          </div>\n\n          <div className=\"flex space-x-3 bg-white p-3 rounded-lg shadow-sm border border-gray-100\">\n            <div className=\"flex-1 relative\">\n              <Search className=\"w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" />\n              <input \n                type=\"text\" \n                placeholder=\"Buscar por cliente, origen, destino, ID...\" \n                className=\"w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded focus:border-coral focus:outline-none text-sm\"\n              />\n            </div>\n            <button className=\"flex items-center px-4 py-2 border border-gray-200 rounded text-sm text-gray-600 hover:bg-gray-50\">\n              <Filter className=\"w-4 h-4 mr-2\" />\n              Filtros\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {initialShipments.map(shp => {\n              const client = initialClients.find(c => c.id === shp.clientId)?.name;\n              return (\n                <div \n                  key={shp.id} \n                  onClick={() => setSelectedShipment(shp)}\n                  className=\"bg-white border border-gray-100 rounded-lg shadow-sm cursor-pointer hover:shadow-md transition-shadow group overflow-hidden\"\n                >\n                  <div className=\"border-b border-gray-100 p-4 flex justify-between items-center bg-gray-50 group-hover:bg-coral group-hover:bg-opacity-5 transition-colors\">\n                    <span className=\"font-bold text-navy flex items-center\">\n                      <Anchor className=\"w-4 h-4 mr-2 text-gray-400 group-hover:text-coral transition-colors\"/>\n                      {shp.id}\n                    </span>\n                    <span className=\"text-xs font-semibold px-2 py-1 bg-gray-200 text-gray-700 rounded-full\">\n                      {shp.type}\n                    </span>\n                  </div>\n                  <div className=\"p-4 space-y-4\">\n                    <div>\n                      <div className=\"text-xs text-gray-500 mb-1\">Cliente</div>\n                      <div className=\"font-medium text-navy\">{client}</div>\n                    </div>\n                    \n                    <div className=\"flex items-center pt-2\">\n                       <div className=\"flex-1\">\n                          <div className=\"font-semibold text-gray-800 text-sm truncate\">{shp.origin.split(\',\')[0]}</div>\n                          <div className=\"text-xs text-gray-500\">Origen</div>\n                       </div>\n                       <div className=\"px-3 text-gray-300\">\342\206\222</div>\n                       <div className=\"flex-1 text-right\">\n                          <div className=\"font-semibold text-gray-800 text-sm truncate\">{shp.destination.split(\',\')[0]}</div>\n                          <div className=\"text-xs text-gray-500\">Destino</div>\n                       </div>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-gray-100 text-sm flex justify-between items-center\">\n                      <span className=\"text-coral font-medium flex items-center\">\n                        <Package className=\"w-4 h-4 mr-1\"/>\n                        {shp.status}\n                      </span>\n                      <span className=\"text-gray-500 text-xs\">ETA: {shp.eta}</span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </>\n      ) : (\n        <div className=\"space-y-6\">\n          <div className=\"flex items-center space-x-2 text-sm text-gray-600\">\n            <button onClick={() => setSelectedShipment(null)} className=\"hover:text-coral transition-colors font-medium\">Embarques</button>\n            <ChevronRight className=\"w-4 h-4\" />\n            <span className=\"text-navy font-bold\">{selectedShipment.id}</span>\n          </div>\n          \n          <div className=\"bg-white rounded-lg shadow-sm border border-gray-100 p-6\">\n            <div className=\"flex justify-between items-start mb-8\">\n              <div>\n                <h3 className=\"text-2xl font-bold text-navy mb-1\">{selectedShipment.id}</h3>\n                <p className=\"text-gray-500\">{initialClients.find(c => c.id === selectedShipment.clientId)?.name}</p>\n              </div>\n              <div className=\"text-right border border-gray-200 rounded p-3 bg-gray-50\">\n                <div className=\"text-xs text-gray-500 mb-1\">Carrier</div>\n                <div className=\"font-bold text-navy\">{selectedShipment.carrier}</div>\n                <div className=\"text-xs text-gray-400 mt-1\">Incoterm: {selectedShipment.incoterm}</div>\n              </div>\n            </div>\n\n            {/* Timeline visual */}\n            <div className=\"mb-10 w-full relative\">\n              <div className=\"overflow-hidden h-2 mb-4 text-xs flex rounded bg-gray-100\">\n                <div style={{ width: `${(selectedShipment.timelineStep / (steps.length - 1)) * 100}%` }} className=\"shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-coral\"></div>\n              </div>\n              <div className=\"flex justify-between text-xs font-medium text-gray-500 -mx-4 sm:mx-0\">\n                {steps.map((step, idx) => (\n                  <div key={idx} className={`flex flex-col items-center ${idx <= selectedShipment.timelineStep ? \'text-coral\' : \'\'} w-1/5 text-center`}>\n                     {idx <= selectedShipment.timelineStep ? <CheckCircle2 className=\"w-5 h-5 mb-1 text-coral\" /> : <div className=\"w-5 h-5 mb-1 rounded-full border-2 border-gray-300\" />}\n                     <span className=\"hidden sm:inline\">{step}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n               <div>\n                 <h4 className=\"font-bold text-navy mb-4 border-b pb-2\">Documentaci\303\263n del Embarque</h4>\n                 <ul className=\"space-y-3\">\n                   {selectedShipment.documents.map((doc, idx) => (\n                     <li key={idx} className=\"flex items-center justify-between p-3 bg-gray-50 rounded border border-gray-100\">\n                       <span className=\"flex items-center text-sm font-medium text-gray-700\">\n                         <File className=\"w-4 h-4 mr-2 text-gray-400\" />\n                         {doc.name}\n                       </span>\n                       {doc.status === \'ok\' ? (\n                         <span className=\"text-xs font-semibold px-2 py-1 bg-green-100 text-green-800 rounded\">Cargado</span>\n                       ) : (\n                         <button className=\"text-xs font-medium px-3 py-1 border border-coral text-coral rounded hover:bg-coral hover:text-white transition-colors\">\n                           Subir archivo\n                         </button>\n                       )}\n                     </li>\n                   ))}\n                 </ul>\n               </div>\n               <div>\n                 <h4 className=\"font-bold text-navy mb-4 border-b pb-2\">Notas Operativas</h4>\n                 <div className=\"bg-yellow-50 border border-yellow-200 p-4 rounded text-sm text-gray-800 h-full\">\n                    {selectedShipment.notes}\n                 </div>\n               </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
