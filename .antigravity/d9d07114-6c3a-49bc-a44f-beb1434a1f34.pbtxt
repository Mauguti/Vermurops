rounded px-4 py-2 text-white focus:outline-none focus:border-coral transition-colors\"\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"w-full bg-coral hover:bg-opacity-90 text-white font-medium py-2.5 rounded transition-colors\"\n          >\n            Ingresar\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}\n"
